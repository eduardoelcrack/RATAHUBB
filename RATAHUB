function Features.GetESPColor(targetPlayer)
	local espCfg = Config.ESP
	if espCfg.FriendCheck and Features.IsFriend(targetPlayer) then
		return ESP_GREEN
	end
	if espCfg.RainbowESP then
		return Color3.fromHSV((tick() % 5) / 5, 1, 1)
	end
	if espCfg.TeamColorHighlight and targetPlayer.TeamColor then
		return targetPlayer.TeamColor.Color
	end
	return COLOR_MAP[espCfg.HighlightColor] or ESP_PURPLE
end

function Features.IsPlayerValidESP(targetPlayer)
	if targetPlayer == LocalPlayer then return false end
	local espCfg = Config.ESP

	-- Whitelist Filtering
	if not Features.IsWhitelisted(targetPlayer, espCfg.WhitelistMode, espCfg.WhitelistTarget) then
		return false
	end

	-- Team Check Filtering
	if Features.IsTeamIgnored(targetPlayer, espCfg.IgnoreTeams) then
		return false
	end

	return true
end

function Features.UpdateESP()
	if not Runtime.ESP.container then
		Runtime.ESP.container = create("Folder", { Name = "RATAHUB_ESP", Parent = screenGui })
	end

	local espCfg = Config.ESP
	local isAnyActive = espCfg.Highlight or espCfg.Names or espCfg.Details or espCfg.Tracers

	if not isAnyActive then
		if Runtime.ESP.loop then
			Runtime.ESP.loop:Disconnect()
			Runtime.ESP.loop = nil
		end
		for _, obj in pairs(Runtime.ESP.objects) do
			if obj.Highlight then obj.Highlight:Destroy() end
			if obj.Billboard then obj.Billboard:Destroy() end
			if obj.TracerLine then obj.TracerLine:Destroy() end
		end
		table.clear(Runtime.ESP.objects)
		return
	end

	if not Runtime.ESP.loop then
		Runtime.ESP.loop = RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			if not cam then return end

			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character then
					local char = p.Character
					local root = char:FindFirstChild("HumanoidRootPart")
					local hum = char:FindFirstChildOfClass("Humanoid")
					local valid = Features.IsPlayerValidESP(p)

					local entry = Runtime.ESP.objects[p]
					if not entry then
						entry = {}
						Runtime.ESP.objects[p] = entry
					end

					local isFr = Features.IsFriend(p)
					local color = Features.GetESPColor(p)

					-- 1. Highlight ESP
					if espCfg.Highlight and valid and hum and hum.Health > 0 then
						if not entry.Highlight or entry.Highlight.Parent ~= char then
							if entry.Highlight then entry.Highlight:Destroy() end
							entry.Highlight = Instance.new("Highlight")
							entry.Highlight.FillTransparency = 0.5
							entry.Highlight.OutlineTransparency = 0
							entry.Highlight.Parent = char
						end
						entry.Highlight.FillColor = color
						entry.Highlight.OutlineColor = isFr and ESP_GREEN or (espCfg.TeamColorHighlight and p.TeamColor and p.TeamColor.Color or THEME.Primary)
						entry.Highlight.Enabled = true
					else
						if entry.Highlight then entry.Highlight.Enabled = false end
					end

					-- 2. Name & Details ESP
					local showNames = (espCfg.Names or espCfg.Details) and valid and hum and hum.Health > 0 and root
					if showNames then
						if not entry.Billboard or entry.Billboard.Parent ~= root then
							if entry.Billboard then entry.Billboard:Destroy() end
							local bb = create("BillboardGui", {
								Name = "ESP_Billboard",
								Adornee = root,
								Size = UDim2.fromOffset(160, 40),
								StudsOffset = Vector3.new(espCfg.OffsetX, 2.5 + espCfg.OffsetY, 0),
								AlwaysOnTop = true,
								Parent = Runtime.ESP.container,
							})
							local lbl = create("TextLabel", {
								Size = UDim2.fromScale(1, 1),
								BackgroundTransparency = 1,
								Font = FONT_BOLD,
								TextSize = espCfg.TextSize,
								TextStrokeTransparency = 0.4,
								TextStrokeColor3 = Color3.new(0, 0, 0),
								Parent = bb,
							})
							entry.Billboard = bb
							entry.Label = lbl
						end

						entry.Billboard.StudsOffset = Vector3.new(espCfg.OffsetX, 2.5 + espCfg.OffsetY, 0)
						entry.Label.TextSize = espCfg.TextSize
						entry.Label.TextColor3 = isFr and ESP_GREEN or color

						local dist = math.floor((cam.CFrame.Position - root.Position).Magnitude)
						if espCfg.Details then
							entry.Label.Text = string.format("%s\n[%d studs] [%d HP]", p.DisplayName or p.Name, dist, math.floor(hum.Health))
						else
							entry.Label.Text = p.DisplayName or p.Name
						end
						entry.Billboard.Enabled = true
					else
						if entry.Billboard then entry.Billboard.Enabled = false end
					end

					-- 3. ESP Tracers (Mutually exclusive with Aimlock Tracers)
					local showTracers = espCfg.Tracers and valid and hum and hum.Health > 0 and root and not Config.Aimlock.EnemyTracers
					if showTracers then
						local screenPos, onScreen = cam:WorldToViewportPoint(root.Position)
						if onScreen then
							if not entry.TracerLine then
								entry.TracerLine = create("Frame", {
									Name = "ESP_Tracer",
									BorderSizePixel = 0,
									AnchorPoint = Vector2.new(0.5, 0.5),
									ZIndex = 2,
									Parent = Runtime.ESP.container,
								})
							end

							local fromPos
							if espCfg.TracerOrigin == "Mouse" then
								local mPos = UserInputService:GetMouseLocation()
								fromPos = Vector2.new(mPos.X, mPos.Y)
							elseif espCfg.TracerOrigin == "Center" then
								fromPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
							else
								fromPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
							end

							local toPos = Vector2.new(screenPos.X, screenPos.Y)
							local dist2D = (toPos - fromPos).Magnitude
							local center = (fromPos + toPos) / 2
							local angle = math.atan2(toPos.Y - fromPos.Y, toPos.X - fromPos.X)

							local tracerColor = isFr and ESP_GREEN or (espCfg.TeamColorTracers and p.TeamColor and p.TeamColor.Color or ESP_RED)

							entry.TracerLine.BackgroundColor3 = tracerColor
							entry.TracerLine.Size = UDim2.fromOffset(dist2D, 1.5)
							entry.TracerLine.Position = UDim2.fromOffset(center.X, center.Y)
							entry.TracerLine.Rotation = math.deg(angle)
							entry.TracerLine.Visible = true
						else
							if entry.TracerLine then entry.TracerLine.Visible = false end
						end
					else
						if entry.TracerLine then entry.TracerLine.Visible = false end
					end
				end
			end
		end)
	end
end

