function Features.UpdateHitboxes()
	local isEnabled = Config.Main.Player.HitboxExpander
	local sizeVal = Config.Main.Player.HitboxSize or 5
	local mode = Config.Main.Player.HitboxWhitelistMode or "Disabled"
	local targetSel = Config.Main.Player.HitboxTarget

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local root = p.Character:FindFirstChild("HumanoidRootPart")
			if root then
				if not Runtime.Hitbox.origs[p] then
					Runtime.Hitbox.origs[p] = {
						Size = root.Size,
						Transparency = root.Transparency,
						CanCollide = root.CanCollide,
					}
				end
				local orig = Runtime.Hitbox.origs[p]
				local valid = isEnabled and Features.IsWhitelisted(p, mode, targetSel)
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				if valid and hum and hum.Health > 0 then
					root.Size = Vector3.new(sizeVal, sizeVal, sizeVal)
					root.Transparency = 0.65
					root.CanCollide = false
				else
					root.Size = orig.Size
					root.Transparency = orig.Transparency
					root.CanCollide = orig.CanCollide
				end
			end
		end
	end
end

function Features.RestoreHitboxes()
	for p, orig in pairs(Runtime.Hitbox.origs) do
		if p and p.Character then
			local root = p.Character:FindFirstChild("HumanoidRootPart")
			if root then
				root.Size = orig.Size
				root.Transparency = orig.Transparency
				root.CanCollide = orig.CanCollide
			end
		end
	end
	table.clear(Runtime.Hitbox.origs)
end

function Features.ToggleHitboxLoop(enable)
	if enable then
		if Runtime.Hitbox.loop then return end
		Runtime.Hitbox.loop = task.spawn(function()
			while Config.Main.Player.HitboxExpander do
				Features.UpdateHitboxes()
				task.wait(0.1)
			end
			Runtime.Hitbox.loop = nil
		end)
	else
		if Runtime.Hitbox.loop then
			pcall(function() task.cancel(Runtime.Hitbox.loop) end)
			Runtime.Hitbox.loop = nil
		end
		Features.RestoreHitboxes()
	end
end

