				RATAHUB:Notify({ Title = "Infinite Jump", Content = "Activado", Duration = 1.2 })
			else
				Features.StopInfiniteJump()
				RATAHUB:Notify({ Title = "Infinite Jump", Content = "Desactivado", Duration = 1.2 })
			end
		end

		-- Aimlock Keybind
		if Config.Aimlock.Enabled and (input.KeyCode.Name == Config.Aimlock.Keybind or input.UserInputType.Name == Config.Aimlock.Keybind) then
			Features.ToggleAimlockActive()
		end

		-- Freecam Keybind
		if Config.Extras.Camera.Freecam and input.KeyCode == Enum.KeyCode.P then
			State.Extras.FreecamActive = not State.Extras.FreecamActive
			if State.Extras.FreecamActive then
				Features.StartFreecam()
				RATAHUB:Notify({ Title = "Freecam", Content = "Activado", Duration = 1.2 })
			else
				Features.StopFreecam()
				RATAHUB:Notify({ Title = "Freecam", Content = "Desactivado", Duration = 1.2 })
			end
		end

		-- Track keys for Fly
		if State.Main.FlyActive and input.UserInputType == Enum.UserInputType.Keyboard then
			Runtime.Fly.keys[input.KeyCode] = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			Runtime.Fly.keys[input.KeyCode] = nil
		end
	end)
end

