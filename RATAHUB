local function refreshAllPlayerDropdowns()
	local list = getPlayerList()
	if Controls.Main.HitboxTarget then Controls.Main.HitboxTarget:Refresh(list, false) end
	if Controls.ESP.WhitelistTarget then Controls.ESP.WhitelistTarget:Refresh(list, false) end
	if Controls.Aimlock.WhitelistTarget then Controls.Aimlock.WhitelistTarget:Refresh(list, false) end
end

Players.PlayerAdded:Connect(function()
	refreshAllPlayerDropdowns()
end)

Players.PlayerRemoving:Connect(function(leavingPlayer)
	Runtime.FriendsCache[leavingPlayer.UserId] = nil

	if Config.Main.Player.HitboxTarget == leavingPlayer.Name then Config.Main.Player.HitboxTarget = "Nadie" end
	if Config.ESP.WhitelistTarget == leavingPlayer.Name then Config.ESP.WhitelistTarget = "Nadie" end
	if Config.Aimlock.WhitelistTarget == leavingPlayer.Name then Config.Aimlock.WhitelistTarget = "Nadie" end

	if Runtime.Aimlock.currentTarget == leavingPlayer then
		Features.UnlockAimlock("left", leavingPlayer.Name)
	end

	if Runtime.ESP.objects[leavingPlayer] then
		local o = Runtime.ESP.objects[leavingPlayer]
		if o.Highlight then o.Highlight:Destroy() end
		if o.Billboard then o.Billboard:Destroy() end
		if o.Tracer then o.Tracer:Destroy() end
		Runtime.ESP.objects[leavingPlayer] = nil
	end

	refreshAllPlayerDropdowns()
end)

