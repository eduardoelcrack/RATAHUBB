------------------------------------------------------------- ESP MODULE
function Features.GetESPColor(targetPlayer)
	local espCfg = Config.ESP
	if espCfg.FriendCheck and Features.IsFriend(targetPlayer) then
		return ESP_GREEN
	end
	if espCfg.RainbowESP then
		return Color3.fromHSV((tick() % 5) / 5, 1, 1)
	end
	if espCfg.TeamColorHighlight and targetPlayer.TeamColor then
		return targetPlayer.TeamColor.Color
	end
	return COLOR_MAP[espCfg.HighlightColor] or ESP_PURPLE
end

function Features.IsWhitelisted(targetPlayer, mode, target)
	if not targetPlayer or targetPlayer == player then return false end
	if mode == "Disabled" then return true end
	local name = targetPlayer.Name
	local isSelected = false
	if type(target) == "table" then
		isSelected = (target[name] == true)
	elseif type(target) == "string" then
		isSelected = (target == name or target == "Todos")
	end
	if not isSelected and GlobalWhitelistTable[name] then
		isSelected = true
	end
	if mode == "Only Whitelist" then
		return isSelected
	elseif mode == "Ignore Whitelist" then
		return not isSelected
	end
	return true
end

function Features.IsSameTeam(p)
	if not p or p == player then return true end
	local lpTeam = player.Team
	local tpTeam = p.Team
	if lpTeam and tpTeam then
		return lpTeam == tpTeam
	end
	if player.TeamColor and p.TeamColor then
		return player.TeamColor == p.TeamColor
	end
	return false
end

function Features.IsPlayerValidESP(targetPlayer)
	if targetPlayer == player then return false end
	local espCfg = Config.ESP

	-- Whitelist Filtering
	if not Features.IsWhitelisted(targetPlayer, espCfg.WhitelistMode, espCfg.WhitelistTarget) then
		return false
	end

	-- Team Check Filtering
	if espCfg.IgnoreTeams ~= "Ninguno" and targetPlayer.Team then
		if targetPlayer.Team.Name == espCfg.IgnoreTeams then return false end
	end

	return true
end

function Features.UpdateESP()
	if not Runtime.ESP.container then
		Runtime.ESP.container = create("Folder", { Name = "RATAHUB_ESP", Parent = screenGui })
	end

	local espCfg = Config.ESP
	local isAnyActive = espCfg.Highlight or espCfg.Names or espCfg.Details or espCfg.Tracers

	if not isAnyActive then
		if Runtime.ESP.loop then
			Runtime.ESP.loop:Disconnect()
			Runtime.ESP.loop = nil
		end
		for _, obj in pairs(Runtime.ESP.objects) do
			if obj.Highlight then obj.Highlight:Destroy() end
			if obj.Billboard then obj.Billboard:Destroy() end
			if obj.Tracer then obj.Tracer:Destroy() end
		end
		table.clear(Runtime.ESP.objects)
		return
	end

	if not Runtime.ESP.loop then
		Runtime.ESP.loop = RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			if not cam then return end

			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player and p.Character then
					local char = p.Character
					local root = char:FindFirstChild("HumanoidRootPart")
					local hum = char:FindFirstChildOfClass("Humanoid")
					local valid = Features.IsPlayerValidESP(p)

					local entry = Runtime.ESP.objects[p]
					if not entry then
						entry = {}
						Runtime.ESP.objects[p] = entry
					end

					local isFriend = Features.IsFriend(p)
					local color = Features.GetESPColor(p)

					-- 1. Highlight
					if espCfg.Highlight and valid and hum and hum.Health > 0 then
						if not entry.Highlight or entry.Highlight.Parent ~= char then
							if entry.Highlight then entry.Highlight:Destroy() end
							entry.Highlight = Instance.new("Highlight")
							entry.Highlight.Adornee = char
							entry.Highlight.FillTransparency = 0.5
							entry.Highlight.OutlineTransparency = 0
							entry.Highlight.Parent = char
						end
						entry.Highlight.FillColor = color
						entry.Highlight.OutlineColor = color
						entry.Highlight.Enabled = true
					elseif entry.Highlight then
						entry.Highlight.Enabled = false
					end

					-- 2. Billboard (Names & Details)
					local showText = (espCfg.Names or espCfg.Details) and valid and hum and hum.Health > 0 and root
					if showText then
						if not entry.Billboard then
							local b = Instance.new("BillboardGui")
							b.Name = "ESP_Tag"
							b.Size = UDim2.new(0, 200, 0, 40)
							b.AlwaysOnTop = true
							b.ResetOnSpawn = false

							local l = Instance.new("TextLabel")
							l.Name = "Tag"
							l.Size = UDim2.fromScale(1, 1)
							l.BackgroundTransparency = 1
							l.Font = FONT_BOLD
							l.TextStrokeTransparency = 0.3
							l.TextStrokeColor3 = Color3.new(0, 0, 0)
							l.Parent = b

							b.Parent = Runtime.ESP.container
							entry.Billboard = b
							entry.Label = l
						end

						entry.Billboard.Adornee = root
						entry.Billboard.StudsOffset = Vector3.new(espCfg.OffsetX, 2.5 + espCfg.OffsetY, 0)
						entry.Billboard.Enabled = true
						entry.Label.TextSize = espCfg.TextSize
						entry.Label.TextColor3 = color

						if espCfg.Details then
							local dist = math.floor((cam.CFrame.Position - root.Position).Magnitude)
							local hp = math.floor(hum.Health)
							entry.Label.Text = string.format("%s\n[%d studs] [%d HP]", p.Name, dist, hp)
						else
							entry.Label.Text = p.Name
						end
					elseif entry.Billboard then
						entry.Billboard.Enabled = false
					end

					-- 3. Tracers
					if espCfg.Tracers and valid and hum and hum.Health > 0 and root then
						local screenPos, onScreen = cam:WorldToViewportPoint(root.Position)
						if onScreen then
							if not entry.Tracer then
								local line = Instance.new("Frame")
								line.AnchorPoint = Vector2.new(0.5, 0.5)
								line.BorderSizePixel = 0
								line.ZIndex = 40
								line.Parent = Runtime.ESP.container
								entry.Tracer = line
							end

							local fromPos
							if espCfg.TracerOrigin == "Mouse" then
								local m = UserInputService:GetMouseLocation()
								fromPos = Vector2.new(m.X, m.Y)
							elseif espCfg.TracerOrigin == "Center" then
								fromPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
							else
								fromPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
							end

							local toPos = Vector2.new(screenPos.X, screenPos.Y)
							local dist = (toPos - fromPos).Magnitude
							local center = (toPos + fromPos) / 2
							local angle = math.atan2(toPos.Y - fromPos.Y, toPos.X - fromPos.X)

							entry.Tracer.Size = UDim2.fromOffset(dist, 1.5)
							entry.Tracer.Position = UDim2.fromOffset(center.X, center.Y)
							entry.Tracer.Rotation = math.deg(angle)

							if isFriend and espCfg.FriendCheck then
								entry.Tracer.BackgroundColor3 = ESP_GREEN
							elseif espCfg.TeamColorTracers and p.TeamColor then
								entry.Tracer.BackgroundColor3 = p.TeamColor.Color
							else
								entry.Tracer.BackgroundColor3 = ESP_RED
							end
							entry.Tracer.Visible = true
						elseif entry.Tracer then
							entry.Tracer.Visible = false
						end
					elseif entry.Tracer then
						entry.Tracer.Visible = false
					end
				end
			end
		end)
	end
end

------------------------------------------------------------- AIMLOCK MODULE (Persistent Target System)
function Features.FindBestAimlockTarget()
	local aimCfg = Config.Aimlock
	local cam = workspace.CurrentCamera
	if not cam then return nil end

	local bestTargetPlayer = nil
	local shortestScreenDist = math.huge
	local mousePos = UserInputService:GetMouseLocation()

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local char = p.Character
			local hum = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")
			local part = char:FindFirstChild(aimCfg.AimPart == "Auto" and "Head" or aimCfg.AimPart) or root

			if hum and hum.Health > 0 and part and root then
				local isValid = true

				-- Friend Check
				if aimCfg.FriendCheck and Features.IsFriend(p) then
					isValid = false
				end

				-- Whitelist
				if not Features.IsWhitelisted(p, aimCfg.WhitelistMode, aimCfg.WhitelistTarget) then
					isValid = false
				end

				-- Team Check
				if aimCfg.TeamCheck and p.Team and player.Team and p.Team == player.Team then
					isValid = false
				end
				if aimCfg.IgnoreTeams ~= "Ninguno" and p.Team and p.Team.Name == aimCfg.IgnoreTeams then
					isValid = false
				end

				-- Max Distance Filter
				local worldDist = (cam.CFrame.Position - part.Position).Magnitude
				if aimCfg.UseMaxDistance and worldDist > aimCfg.MaxDistance then
					isValid = false
				end

				if isValid then
					local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen then
						local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
						if (not aimCfg.UseFOV or screenDist <= aimCfg.FOVSize) and screenDist < shortestScreenDist then
							shortestScreenDist = screenDist
							bestTargetPlayer = p
						end
					end
				end
			end
		end
	end
	return bestTargetPlayer
end

function Features.UnlockAimlock(reason, targetName)
	Runtime.Aimlock.locked = false
	Runtime.Aimlock.currentTarget = nil

	if Runtime.Aimlock.tracer then
		Runtime.Aimlock.tracer.Visible = false
	end

	if reason == "died" and targetName then
		RATAHUB:Notify({ Title = "Aimlock", Content = targetName .. " se murió", Duration = 1.5 })
	elseif reason == "left" and targetName then
		RATAHUB:Notify({ Title = "Aimlock", Content = targetName .. " se salió/desapareció", Duration = 1.5 })
	end
end

function Features.ToggleAimlockLock()
	if not Config.Aimlock.Enabled then return end

	if Runtime.Aimlock.locked then
		Features.UnlockAimlock()
		RATAHUB:Notify({ Title = "Aimlock", Content = "Desbloqueado", Duration = 1.2 })
	else
		local candidate = Features.FindBestAimlockTarget()
		if candidate then
			Runtime.Aimlock.currentTarget = candidate
			Runtime.Aimlock.locked = true
			RATAHUB:Notify({ Title = "Aimlock", Content = "Lockeaste a " .. candidate.Name, Duration = 1.5 })
		else
			RATAHUB:Notify({ Title = "Aimlock", Content = "No hay nadie para lockear", Duration = 1.5 })
		end
	end
end

function Features.UpdateAimlock()
	local aimCfg = Config.Aimlock
	if not aimCfg.Enabled then
		if Runtime.Aimlock.loop then
			Runtime.Aimlock.loop:Disconnect()
			Runtime.Aimlock.loop = nil
		end
		Features.UnlockAimlock()
		return
	end

	if not Runtime.Aimlock.loop then
		Runtime.Aimlock.loop = RunService.RenderStepped:Connect(function()
			if Config.Aimlock.Enabled and Config.Aimlock.UseFOV then
				if not Runtime.Aimlock.fovCircle then
					Runtime.Aimlock.fovCircle = create("Frame", {
						Name = "FOVCircle",
						AnchorPoint = Vector2.new(0.5, 0.5),
						BackgroundTransparency = 1,
						ZIndex = 2,
						Parent = screenGui,
					})
					corner(999, Runtime.Aimlock.fovCircle)
					stroke(Runtime.Aimlock.fovCircle, 0.5, THEME.Primary, 1.5)
				end
				local mPos = UserInputService:GetMouseLocation()
				Runtime.Aimlock.fovCircle.Position = UDim2.fromOffset(mPos.X, mPos.Y)
				Runtime.Aimlock.fovCircle.Size = UDim2.fromOffset(Config.Aimlock.FOVSize * 2, Config.Aimlock.FOVSize * 2)
				Runtime.Aimlock.fovCircle.Visible = true
			else
				if Runtime.Aimlock.fovCircle then Runtime.Aimlock.fovCircle.Visible = false end
			end

			if not Config.Aimlock.Enabled or not Runtime.Aimlock.locked or not Runtime.Aimlock.currentTarget then
				if Runtime.Aimlock.tracer then Runtime.Aimlock.tracer.Visible = false end
				return
			end

			local targetPlayer = Runtime.Aimlock.currentTarget
			local targetName = targetPlayer.Name

			-- Check if target is still in the game
			if not targetPlayer.Parent then
				Features.UnlockAimlock("left", targetName)
				return
			end

			local char = targetPlayer.Character
			if not char then
				Features.UnlockAimlock("left", targetName)
				return
			end

			local hum = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")
			local part = char:FindFirstChild(Config.Aimlock.AimPart == "Auto" and "Head" or Config.Aimlock.AimPart) or root

			if not hum or hum.Health <= 0 then
				Features.UnlockAimlock("died", targetName)
				return
			end

			if not part then
				Features.UnlockAimlock("left", targetName)
				return
			end

			local cam = workspace.CurrentCamera
			if not cam then return end

			-- Prediction
			local targetPos = part.Position
			if Config.Aimlock.Prediction and root then
				local vel = root.AssemblyLinearVelocity
				targetPos = targetPos + (vel * Config.Aimlock.PredictionTime)
			end

			local targetCF = CFrame.new(cam.CFrame.Position, targetPos)
			local smooth = math.clamp(1 - (Config.Aimlock.Smoothness / 100), 0.05, 1)
			cam.CFrame = cam.CFrame:Lerp(targetCF, smooth)

			-- Aimlock Tracer
			if Config.Aimlock.EnemyTracers and root then
				local screenPos, onScreen = cam:WorldToViewportPoint(root.Position)
				if onScreen then
					if not Runtime.Aimlock.tracer then
						Runtime.Aimlock.tracer = Instance.new("Frame")
						Runtime.Aimlock.tracer.AnchorPoint = Vector2.new(0.5, 0.5)
						Runtime.Aimlock.tracer.BorderSizePixel = 0
						Runtime.Aimlock.tracer.ZIndex = 45
						Runtime.Aimlock.tracer.Parent = screenGui
					end

					local fromPos
					if Config.Aimlock.TracerOrigin == "Mouse" then
						local m = UserInputService:GetMouseLocation()
						fromPos = Vector2.new(m.X, m.Y)
					else
						fromPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
					end

					local toPos = Vector2.new(screenPos.X, screenPos.Y)
					local dist = (toPos - fromPos).Magnitude
					local center = (toPos + fromPos) / 2
					local angle = math.atan2(toPos.Y - fromPos.Y, toPos.X - fromPos.X)

					Runtime.Aimlock.tracer.Size = UDim2.fromOffset(dist, 1.5)
					Runtime.Aimlock.tracer.Position = UDim2.fromOffset(center.X, center.Y)
					Runtime.Aimlock.tracer.Rotation = math.deg(angle)
					Runtime.Aimlock.tracer.BackgroundColor3 = ESP_RED
					Runtime.Aimlock.tracer.Visible = true
				elseif Runtime.Aimlock.tracer then
					Runtime.Aimlock.tracer.Visible = false
				end
			elseif Runtime.Aimlock.tracer then
				Runtime.Aimlock.tracer.Visible = false
			end
		end)
	end
end

