function Features.SetUnlockMaxDistance(enabled)
	if enabled then
		Runtime.Camera.savedMaxZoom = Runtime.Camera.savedMaxZoom or player.CameraMaxZoomDistance
		player.CameraMaxZoomDistance = 1e9
	else
		player.CameraMaxZoomDistance = Runtime.Camera.savedMaxZoom or 128
