function Features.StartHotkeys()
	if Runtime.Hotkeys.conn then return end
	Runtime.Hotkeys.conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local name = input.KeyCode.Name

		if name == Config.Main.Movement.FlyKeybind then
			Features.ToggleFlyActive()
		elseif name == Config.Main.Movement.WalkSpeedKeybind then
			Features.ToggleWalkSpeed()
		elseif name == Config.Main.Movement.InfiniteJumpKeybind then
			Features.ToggleInfiniteJumpActive()
		elseif name == Config.Main.Movement.NoclipKeybind then
			Features.ToggleNoclipActive()
		elseif name == Config.Aimlock.Keybind then
			Features.ToggleAimlockLock()
		end
	end)
end

