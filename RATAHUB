local function CreateESPForPlayer(player)
	if activeESPDrawings[player] then return end

	local box = Drawing and Drawing.new and Drawing.new("Square") or nil
	local nameText = Drawing and Drawing.new and Drawing.new("Text") or nil
	local distText = Drawing and Drawing.new and Drawing.new("Text") or nil

	if box then
		box.Visible = false
		box.Color = Color3.fromRGB(160, 80, 240) -- Morado Original
		box.Thickness = 1.5
		box.Filled = false
	end

	if nameText then
		nameText.Visible = false
		nameText.Color = Color3.fromRGB(200, 140, 255)
		nameText.Size = 13
		nameText.Center = true
		nameText.Outline = true
	end

	if distText then
		distText.Visible = false
		distText.Color = Color3.fromRGB(220, 220, 230)
		distText.Size = 11
		distText.Center = true
		distText.Outline = true
	end

	activeESPDrawings[player] = {
		Box = box,
		NameText = nameText,
		DistText = distText,
	}
end

local function RemoveESPForPlayer(player)
	local drawings = activeESPDrawings[player]
	if drawings then
		if drawings.Box then drawings.Box:Remove() end
		if drawings.NameText then drawings.NameText:Remove() end
		if drawings.DistText then drawings.DistText:Remove() end
		activeESPDrawings[player] = nil
	end
end

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= LocalPlayer then CreateESPForPlayer(p) end
end
Players.PlayerAdded:Connect(CreateESPForPlayer)
Players.PlayerRemoving:Connect(RemoveESPForPlayer)

