-- Acquire closest target in screen space (respecting all configured filters)
function Features.GetAimlockTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end

	local mousePos = UserInputService:GetMouseLocation()
	local aimCfg = Config.Aimlock
	local bestTarget = nil
	local bestDist = math.huge

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local part = p.Character:FindFirstChild(aimCfg.AimPart) or p.Character:FindFirstChild("HumanoidRootPart")

			if hum and hum.Health > 0 and part then
				local isFr = Features.IsFriend(p)
				if not (aimCfg.FriendCheck and isFr) then
					local sameTeam = Features.IsSameTeam(p)
					if not (aimCfg.TeamCheck and sameTeam) then
						if not Features.IsTeamIgnored(p, aimCfg.IgnoreTeams) then
							if Features.IsWhitelisted(p, aimCfg.WhitelistMode, aimCfg.WhitelistTarget) then
								local worldDist = (cam.CFrame.Position - part.Position).Magnitude
								if not aimCfg.UseMaxDistance or worldDist <= aimCfg.MaxDistance then
									local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
									if onScreen then
										local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
										if not aimCfg.UseFOV or dist2D <= aimCfg.FOVSize then
											if dist2D < bestDist then
												bestDist = dist2D
												bestTarget = p
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end

	return bestTarget
end

