RunService.RenderStepped:Connect(function(deltaTime)
	local mousePos = UserInputService:GetMouseLocation()
	local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

	-- 1. FOV Visual Circle
	if Config.Aimlock.Enabled and Config.Aimlock.UseFOV then
		fovCircle.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
		fovCircle.Size = UDim2.new(0, Config.Aimlock.FOVSize * 2, 0, Config.Aimlock.FOVSize * 2)
		fovCircle.Visible = true
	else
		fovCircle.Visible = false
	end

	-- 2. Fly Físico
	if Config.Main.Movement.FlyEnabled and Config.Main.Movement.FlyActive and flyBodyVelocity and flyBodyGyro then
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			flyBodyGyro.CFrame = Camera.CFrame
			local velocity = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then velocity = velocity + (Camera.CFrame.LookVector * Config.Main.Movement.FlySpeed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then velocity = velocity - (Camera.CFrame.LookVector * Config.Main.Movement.FlySpeed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then velocity = velocity - (Camera.CFrame.RightVector * Config.Main.Movement.FlySpeed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then velocity = velocity + (Camera.CFrame.RightVector * Config.Main.Movement.FlySpeed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then velocity = velocity + Vector3.new(0, Config.Main.Movement.FlySpeed, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then velocity = velocity - Vector3.new(0, Config.Main.Movement.FlySpeed, 0) end
			flyBodyVelocity.Velocity = velocity
		end
	end

	-- 3. No Clip Físico
	if Config.Main.Movement.NoclipEnabled and Config.Main.Movement.NoclipActive then
		local char = LocalPlayer.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
				end
			end
		end
	end

	-- 4. Freecam Físico
	if Config.Extras.Camera.Freecam and freecamCFrame then
		local moveSpeed = Config.Extras.Camera.FreecamSpeed * 0.5
		local deltaPos = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then deltaPos = deltaPos + (freecamCFrame.LookVector * moveSpeed) end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then deltaPos = deltaPos - (freecamCFrame.LookVector * moveSpeed) end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then deltaPos = deltaPos - (freecamCFrame.RightVector * moveSpeed) end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then deltaPos = deltaPos + (freecamCFrame.RightVector * moveSpeed) end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) then deltaPos = deltaPos + Vector3.new(0, moveSpeed, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) then deltaPos = deltaPos - Vector3.new(0, moveSpeed, 0) end
		freecamCFrame = freecamCFrame + deltaPos
		Camera.CFrame = freecamCFrame
	end

	-- 5. Aimlock Camera Interpolation & Desconexión/Muerte
	if Config.Aimlock.Enabled and Config.Aimlock.Active and Config.Aimlock.Target then
		local targetPlayer = Config.Aimlock.Target
		local targetChar = targetPlayer.Character
		local humanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
		local targetPart = targetChar and (
			Config.Aimlock.AimPart == "Head" and targetChar:FindFirstChild("Head") or
			Config.Aimlock.AimPart == "Torso" and (targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("UpperTorso")) or
			targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart")
		)

		if not targetChar or not targetChar.Parent or not targetPart then
			Config.Aimlock.Active = false
			Config.Aimlock.Target = nil
			Notify("Aimlock", targetPlayer.Name .. " se salió/desapareció", 2.5)
		elseif not humanoid or humanoid.Health <= 0 then
			Config.Aimlock.Active = false
			Config.Aimlock.Target = nil
			Notify("Aimlock", targetPlayer.Name .. " se murió", 2.5)
		else
			local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
			Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(1 - Config.Aimlock.Smoothness, 0.05, 1))
		end
	end

	-- 6. Triggerbot Raycast
	if Config.Triggerbot.Enabled then
		local target = Mouse.Target
		if target and target.Parent then
			local player = Players:GetPlayerFromCharacter(target.Parent) or Players:GetPlayerFromCharacter(target.Parent.Parent)
			if player and ShouldTargetPlayer(player, Config.Triggerbot.WhitelistMode, Config.Triggerbot.TeamCheck, Config.Triggerbot.FriendCheck) then
				if mouse1click then
					task.wait(Config.Triggerbot.Delay / 1000)
					mouse1click()
					if Config.Sounds.HitSound then
						PlayAudio(Config.Sounds.SoundList[Config.Sounds.SelectedSound])
					end
				end
			end
		end
	end

	-- 7. Actualización Periódica de Hitboxes
	UpdateHitboxes()

	-- 8. ESP Rendering (Boxes, Nombres y Tracers)
	local activeTracerTarget = nil

	-- Determinar Tracer de Aimlock o ESP
	if Config.Aimlock.Tracers and Config.Aimlock.Active and Config.Aimlock.Target then
		local char = Config.Aimlock.Target.Character
		activeTracerTarget = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
	end

	for player, drawings in pairs(activeESPDrawings) do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		local isFriend = IsFriend(player)
		local isValid = char and root and hum and hum.Health > 0 and (Config.ESP.Enabled and (isFriend or ShouldTargetPlayer(player, Config.ESP.WhitelistMode, Config.ESP.TeamCheck, false)))

		if isValid then
			local pos3D = root.Position
			local dist3D = (pos3D - Camera.CFrame.Position).Magnitude

			if dist3D <= Config.ESP.MaxDistance then
				local screenPos, onScreen = Camera:WorldToViewportPoint(pos3D)
				if onScreen then
					local color = isFriend and Color3.fromRGB(50, 220, 100) or Color3.fromRGB(160, 80, 240)
					local topPos = Camera:WorldToViewportPoint(pos3D + Vector3.new(0, 3, 0))
					local bottomPos = Camera:WorldToViewportPoint(pos3D - Vector3.new(0, 3.5, 0))
					local boxHeight = math.abs(topPos.Y - bottomPos.Y)
					local boxWidth = boxHeight * 0.65

					-- Box ESP
					if drawings.Box and Config.ESP.Boxes then
						drawings.Box.Size = Vector2.new(boxWidth, boxHeight)
						drawings.Box.Position = Vector2.new(screenPos.X - (boxWidth / 2), screenPos.Y - (boxHeight / 2))
						drawings.Box.Color = color
						drawings.Box.Visible = true
					elseif drawings.Box then
						drawings.Box.Visible = false
					end

					-- Name ESP
					if drawings.NameText and Config.ESP.Names then
						drawings.NameText.Text = (isFriend and "[AMIGO] " or "") .. player.Name
						drawings.NameText.Position = Vector2.new(screenPos.X, screenPos.Y - (boxHeight / 2) - 16)
						drawings.NameText.Color = isFriend and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(200, 140, 255)
						drawings.NameText.Visible = true
					elseif drawings.NameText then
						drawings.NameText.Visible = false
					end

					-- Distance ESP
					if drawings.DistText and Config.ESP.Distance then
						drawings.DistText.Text = math.floor(dist3D) .. " studs"
						drawings.DistText.Position = Vector2.new(screenPos.X, screenPos.Y + (boxHeight / 2) + 2)
						drawings.DistText.Visible = true
					elseif drawings.DistText then
						drawings.DistText.Visible = false
					end

					-- Tracer Target selection para ESP si no hay Aimlock tracer
					if not activeTracerTarget and Config.ESP.Tracers then
						activeTracerTarget = root
					end
				else
					if drawings.Box then drawings.Box.Visible = false end
					if drawings.NameText then drawings.NameText.Visible = false end
					if drawings.DistText then drawings.DistText.Visible = false end
				end
			else
				if drawings.Box then drawings.Box.Visible = false end
				if drawings.NameText then drawings.NameText.Visible = false end
				if drawings.DistText then drawings.DistText.Visible = false end
			end
		else
			if drawings.Box then drawings.Box.Visible = false end
			if drawings.NameText then drawings.NameText.Visible = false end
			if drawings.DistText then drawings.DistText.Visible = false end
		end
	end

	-- 9. Renderizado de Tracer
	if tracerLine then
		if activeTracerTarget then
			local screenPos, onScreen = Camera:WorldToViewportPoint(activeTracerTarget.Position)
			if onScreen then
				tracerLine.From = screenCenter
				tracerLine.To = Vector2.new(screenPos.X, screenPos.Y)
				tracerLine.Color = Color3.fromRGB(255, 0, 0)
				tracerLine.Visible = true
			else
				tracerLine.Visible = false
			end
		else
			tracerLine.Visible = false
		end
	end
end)

