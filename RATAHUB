		function TabObj:CreateSlider(cfg)
			cfg = cfg or {}
			local card = self:_ensureCard()
			local sliderName = cfg.Name or "Slider"
			local minV = cfg.Range and cfg.Range[1] or 0
			local maxV = cfg.Range and cfg.Range[2] or 100
			local inc = cfg.Increment or 1
			local suffix = cfg.Suffix or ""
			local cb = cfg.Callback or function() end
			local decimals = getDecimals(inc)

			local function cleanRound(val)
				local snapped = math.floor(((val - minV) / inc) + 0.5) * inc + minV
				if decimals > 0 then
					local factor = 10 ^ decimals
					snapped = math.floor(snapped * factor + 0.5) / factor
				else
					snapped = math.floor(snapped + 0.5)
				end
				return clamp(snapped, minV, maxV)
			end

			local value = cleanRound(cfg.CurrentValue or minV)

			local row = create("Frame", {
				LayoutOrder = self:_cardOrder(card),
				Size = UDim2.new(1, 0, 0, 44),
				BackgroundTransparency = 1,
				Parent = card,
			})

			local label = create("TextLabel", {
				Size = UDim2.new(1, -80, 0, 16),
				BackgroundTransparency = 1,
				Text = sliderName,
				TextColor3 = THEME.Foreground,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = FONT,
				TextSize = 13,
				Parent = row,
			})

			local function formatVal(v)
				if decimals > 0 then
					return string.format("%." .. decimals .. "f", v)
				else
					return string.format("%d", math.floor(v + 0.5))
				end
			end

			local valueLabel = create("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.fromOffset(80, 16),
				BackgroundTransparency = 1,
				Text = formatVal(value) .. suffix,
				TextColor3 = THEME.Primary,
				TextXAlignment = Enum.TextXAlignment.Right,
				Font = FONT_MONO,
				TextSize = 13,
				Parent = row,
			})

			local track = create("TextButton", {
				Position = UDim2.fromOffset(0, 26),
				Size = UDim2.new(1, 0, 0, 6),
				BackgroundColor3 = THEME.Secondary,
				Text = "",
				AutoButtonColor = false,
				Parent = row,
			})
			corner(3, track)

			local fill = create("Frame", {
				Size = UDim2.new((value - minV) / math.max(1, (maxV - minV)), 0, 1, 0),
				BackgroundColor3 = THEME.Primary,
				BorderSizePixel = 0,
				Parent = track,
			})
			corner(3, fill)

			local knob = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(12, 12),
				BackgroundColor3 = THEME.Foreground,
				BorderSizePixel = 0,
				Parent = fill,
			})
			corner(6, knob)

			local function setVal(newV, fireCallback)
				value = cleanRound(newV)
				local alpha = clamp((value - minV) / math.max(1, (maxV - minV)), 0, 1)
				fill.Size = UDim2.new(alpha, 0, 1, 0)
				valueLabel.Text = formatVal(value) .. suffix
				if fireCallback ~= false then
					cb(value)
				end
			end

			local isSliding = false
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isSliding = true
					local absPos = track.AbsolutePosition.X
					local absSize = track.AbsoluteSize.X
					local relative = clamp((input.Position.X - absPos) / absSize, 0, 1)
					setVal(minV + relative * (maxV - minV), true)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isSliding = false
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if isSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local absPos = track.AbsolutePosition.X
					local absSize = track.AbsoluteSize.X
					local relative = clamp((input.Position.X - absPos) / absSize, 0, 1)
					setVal(minV + relative * (maxV - minV), true)
				end
			end)

			return {
				Set = function(_, v) setVal(v, true) end,
				SetSilent = function(_, v) setVal(v, false) end,
				GetValue = function() return value end,
			}
		end

