	local inner = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = THEME.Stroke,
		ScrollBarImageTransparency = 0.6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 86,
		Parent = list,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = inner,
	})

	local handle = {}
	local open = false
	local scrollConn = nil
	local setOpen
	local rebuildOptions

	local function updatePopupGeometry()
		if not open then return end
		local btnPos = btn.AbsolutePosition
		local winPos = windowInstance.gui.AbsolutePosition
		local scrollFrame = windowInstance._scroll

		local sPos = scrollFrame.AbsolutePosition
		local sSize = scrollFrame.AbsoluteSize
		if btnPos.Y < sPos.Y - 20 or btnPos.Y > (sPos.Y + sSize.Y) then
			setOpen(false)
			return
		end

		local relX = btnPos.X - winPos.X
		local relY = btnPos.Y - winPos.Y + btn.AbsoluteSize.Y + 4
		list.Position = UDim2.fromOffset(relX, relY)
		list.Size = UDim2.fromOffset(btn.AbsoluteSize.X, listHeight)
	end

	setOpen = function(v)
		if v == open then return end
		open = v
		if open then
			if windowInstance._currentDropdownClose and windowInstance._currentDropdownClose ~= setOpen then
				windowInstance._currentDropdownClose(false)
			end
			windowInstance._currentDropdownClose = setOpen
			windowInstance._currentDropdownReposition = updatePopupGeometry

			rebuildOptions()
			updatePopupGeometry()
			list.Visible = true
			tween(arrow, DROP, { Rotation = 180 })
			tween(list, DROP, { Size = UDim2.fromOffset(btn.AbsoluteSize.X, listHeight) })

			if not scrollConn then
				scrollConn = windowInstance._scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(updatePopupGeometry)
			end
		else
			if windowInstance._currentDropdownClose == setOpen then
				windowInstance._currentDropdownClose = nil
				windowInstance._currentDropdownReposition = nil
			end
			if scrollConn then
				scrollConn:Disconnect()
				scrollConn = nil
			end
			tween(arrow, DROP, { Rotation = 0 })
			local t = tween(list, DROP, { Size = UDim2.fromOffset(btn.AbsoluteSize.X, 0) })
			t.Completed:Connect(function()
				if not open then list.Visible = false end
			end)
		end
	end

	local function choose(opt)
		if isMulti then
			selectedMulti[opt] = not selectedMulti[opt]
			if not selectedMulti[opt] then selectedMulti[opt] = nil end
			selectedLabel.Text = getDisplayText()
			rebuildOptions()
			if cfg.Callback then task.spawn(cfg.Callback, selectedMulti) end
		else
			current = opt
			selectedLabel.Text = tostring(opt)
			setOpen(false)
			if cfg.Callback then task.spawn(cfg.Callback, opt) end
		end
	end

	rebuildOptions = function()
		for _, child in ipairs(inner:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		listHeight = math.min(#options, 5) * 30 + 8
		if open then
			updatePopupGeometry()
		end
		for i, opt in ipairs(options) do
			local isSel = isMulti and (selectedMulti[opt] == true) or (current == opt)
			local item = create("TextButton", {
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = THEME.Secondary,
				BackgroundTransparency = isSel and 0.85 or 1,
				Text = tostring(opt) .. (isSel and " ✓" or ""),
				TextColor3 = isSel and THEME.Primary or THEME.Muted,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = isSel and FONT_BOLD or FONT,
				TextSize = 13,
				AutoButtonColor = false,
				ZIndex = 87,
				Parent = inner,
			})
			corner(6, item)
			padding(item, nil, 10, 6, 0, 0)
			item.MouseEnter:Connect(function()
				if not (isMulti and selectedMulti[opt] == true or not isMulti and current == opt) then
					tween(item, HOVER, { BackgroundTransparency = 0.85, TextColor3 = THEME.Foreground })
				end
			end)
			item.MouseLeave:Connect(function()
				if not (isMulti and selectedMulti[opt] == true or not isMulti and current == opt) then
					tween(item, HOVER, { BackgroundTransparency = 1, TextColor3 = THEME.Muted })
				end
			end)
			item.MouseButton1Click:Connect(function()
				choose(opt)
			end)
		end
	end

	rebuildOptions()

	btn.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	function handle:Refresh(newOptions, resetSelection)
		options = newOptions or {}
		if not isMulti then
			if resetSelection or not table.find(options, current) then
				current = options[1] or ""
				selectedLabel.Text = tostring(current)
			end
		else
			selectedLabel.Text = getDisplayText()
		end
		rebuildOptions()
	end

	function handle:Set(v)
		if isMulti then
			selectedMulti = {}
			if type(v) == "table" then
				for k, val in pairs(v) do
					if type(k) == "string" and val == true then selectedMulti[k] = true
					elseif type(val) == "string" then selectedMulti[val] = true end
				end
			elseif type(v) == "string" and v ~= "" and v ~= "Nadie" then
				selectedMulti[v] = true
			end
			selectedLabel.Text = getDisplayText()
			if open then rebuildOptions() end
			if cfg.Callback then task.spawn(cfg.Callback, selectedMulti) end
		else
			current = v
			selectedLabel.Text = tostring(v)
			if open then rebuildOptions() end
			if cfg.Callback then task.spawn(cfg.Callback, v) end
		end
	end
	function handle:SetSilent(v)
		if isMulti then
			selectedMulti = {}
			if type(v) == "table" then
				for k, val in pairs(v) do
					if type(k) == "string" and val == true then selectedMulti[k] = true
					elseif type(val) == "string" then selectedMulti[val] = true end
				end
			elseif type(v) == "string" and v ~= "" and v ~= "Nadie" then
				selectedMulti[v] = true
			end
			selectedLabel.Text = getDisplayText()
			if open then rebuildOptions() end
		else
			current = v
			selectedLabel.Text = tostring(v)
			if open then rebuildOptions() end
		end
	end
	function handle:Get() return isMulti and selectedMulti or current end
	return handle
end

function Tab:CreateKeybind(cfg)
	cfg = cfg or {}
	local card = self:_ensureCard()
	local currentKey = cfg.CurrentKeybind or "None"

	local row = create("Frame", {
		LayoutOrder = self:_cardOrder(card),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		Parent = card,
	})
	create("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -110, 1, 0),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Keybind",
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT, TextSize = 14,
		Parent = row,
	})
	local btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(100, 28),
		BackgroundColor3 = THEME.Secondary,
		Text = tostring(currentKey),
		TextColor3 = THEME.Foreground,
		Font = FONT_MONO, TextSize = 12,
		AutoButtonColor = false,
		Parent = row,
	})
	corner(8, btn)
	stroke(btn, 0.9)
	attachInteract(btn, { hover = 1.03, press = 0.96 })

	local handle = {}
	local listening = false
	local captureConn

	local function stopListening()
		listening = false
		if captureConn then captureConn:Disconnect() captureConn = nil end
	end

	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		btn.Text = "Press a key..."
		tween(btn, HOVER, { BackgroundColor3 = THEME.Primary })
		btn.TextColor3 = THEME.PrimaryText

		captureConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end

			if input.KeyCode == Enum.KeyCode.Escape then
				stopListening()
				btn.Text = tostring(currentKey)
				tween(btn, HOVER, { BackgroundColor3 = THEME.Secondary })
				btn.TextColor3 = THEME.Foreground
				return
			end

			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
				currentKey = input.KeyCode.Name
				stopListening()
				btn.Text = currentKey
				tween(btn, HOVER, { BackgroundColor3 = THEME.Secondary })
				btn.TextColor3 = THEME.Foreground
				if cfg.Callback then task.spawn(cfg.Callback, input.KeyCode) end
			end
		end)
	end)

	function handle:Set(keyName)
		if typeof(keyName) == "EnumItem" then
			keyName = keyName.Name
		end
		currentKey = keyName
		btn.Text = tostring(keyName)
	end
	function handle:Get() return currentKey end
	return handle
end

function Tab:CreateButton(cfg)
	cfg = cfg or {}
