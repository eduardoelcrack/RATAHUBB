-- Movement: Fly
function Features.StartFly()
	if Runtime.Fly.loop then return end
	local root = getRoot()
	if not root then return end

	local bg = Instance.new("BodyGyro")
	bg.P = 9e4
	bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bg.CFrame = root.CFrame
	bg.Parent = root
	Runtime.Fly.bodyGyro = bg

	local bv = Instance.new("BodyVelocity")
	bv.Velocity = Vector3.zero
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bv.Parent = root
	Runtime.Fly.bodyVel = bv

	local keys = Runtime.Fly.keys
	table.clear(keys)

	Runtime.Fly.loop = RunService.RenderStepped:Connect(function()
		if not State.Main.FlyActive or not Config.Main.Fly then
			Features.StopFly()
			return
		end
		local r = getRoot()
		local cam = workspace.CurrentCamera
		if not r or not cam then return end

		bg.CFrame = cam.CFrame
		local moveDir = Vector3.zero

		if keys[Enum.KeyCode.W] then moveDir = moveDir + cam.CFrame.LookVector end
		if keys[Enum.KeyCode.S] then moveDir = moveDir - cam.CFrame.LookVector end
		if keys[Enum.KeyCode.A] then moveDir = moveDir - cam.CFrame.RightVector end
		if keys[Enum.KeyCode.D] then moveDir = moveDir + cam.CFrame.RightVector end
		if keys[Enum.KeyCode.Space] then moveDir = moveDir + Vector3.new(0, 1, 0) end
		if keys[Enum.KeyCode.LeftControl] or keys[Enum.KeyCode.LeftShift] then moveDir = moveDir - Vector3.new(0, 1, 0) end

		if moveDir.Magnitude > 0 then
			bv.Velocity = moveDir.Unit * Config.Main.FlySpeed
		else
			bv.Velocity = Vector3.zero
		end
	end)
end

function Features.StopFly()
	if Runtime.Fly.loop then
		Runtime.Fly.loop:Disconnect()
		Runtime.Fly.loop = nil
	end
	if Runtime.Fly.bodyGyro then
		Runtime.Fly.bodyGyro:Destroy()
		Runtime.Fly.bodyGyro = nil
	end
	if Runtime.Fly.bodyVel then
		Runtime.Fly.bodyVel:Destroy()
		Runtime.Fly.bodyVel = nil
	end
	table.clear(Runtime.Fly.keys)
end

-- Movement: Noclip
function Features.StartNoclip()
	if Runtime.Noclip.loop then return end
	Runtime.Noclip.loop = RunService.Stepped:Connect(function()
		if not State.Main.NoclipActive or not Config.Main.Noclip then
			Features.StopNoclip()
			return
		end
		local char = getChar()
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
				end
			end
		end
	end)
end

function Features.StopNoclip()
	if Runtime.Noclip.loop then
		Runtime.Noclip.loop:Disconnect()
		Runtime.Noclip.loop = nil
	end
end

