	sounds:CreateToggle({ Name = "Lock Sound (Sonido al fijar)", CurrentValue = false, Callback = function(_) end })
	sounds:CreateDropdown({ Name = "Sonido para Lock Target", Options = SOUND_LIST, CurrentOption = "Skeet / Gamesense", Callback = function(_) end })
	sounds:CreateToggle({ Name = "Hit Sound (Sonido al golpear/disparar)", CurrentValue = false, Callback = function(_) end })
	sounds:CreateDropdown({ Name = "Sonido para Hit / Disparo", Options = SOUND_LIST, CurrentOption = "Neverlose Hit", Callback = function(_) end })

	sounds:CreateSection("Probar & Escuchar Sonidos")
	sounds:CreateDropdown({ Name = "Lista de Sonidos", Options = SOUND_LIST, CurrentOption = "Skeet / Gamesense", Callback = function(_) end })
	sounds:CreateButton({ Name = "Reproducir Sonido Seleccionado", Callback = function() end })
	sounds:CreateButton({
		Name = "🚨 Destroy Hub (Apagar Todo)",
		Destructive = true,
		Callback = function()
			Features.DestroyHub()
		end,
	})
end

-- Initialize event hotkeys listener
Features.StartHotkeys()

-- Return framework handle
return {
	RATAHUB = RATAHUB,
	Window = win,
	Adapter = RATAHUBAdapter.wrap(win),
	Config = Config,
	Controls = Controls,
	Features = Features,
}
