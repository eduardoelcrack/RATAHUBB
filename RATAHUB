local function create(className, props, children)
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				inst[k] = v
			end
		end
		if props.Parent then
			inst.Parent = props.Parent
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	return inst
end

local function corner(r, parent)
	return create("UICorner", { CornerRadius = UDim.new(0, r or 10), Parent = parent })
end

local function stroke(parent, trans, color, thickness)
	return create("UIStroke", {
		Color = color or THEME.Stroke,
		Transparency = trans or 0.85,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function padding(parent, all, x, y, top, bot)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top or y or all or 0),
		PaddingBottom = UDim.new(0, bot or y or all or 0),
		PaddingLeft = UDim.new(0, x or all or 0),
		PaddingRight = UDim.new(0, x or all or 0),
		Parent = parent,
	})
end

local function tween(obj, info, props)
	if not obj then return end
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function clamp(val, minV, maxV)
	if val < minV then return minV end
	if val > maxV then return maxV end
	return val
end

local function getDecimals(num)
	local s = tostring(num)
	local dot = s:find("%.")
	if not dot then return 0 end
	return #s - dot
end

local function getChar(plr)
	plr = plr or LocalPlayer
	return plr and plr.Character
end

local function getHum(plr)
	local c = getChar(plr)
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot(plr)
	local c = getChar(plr)
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function isAlive(plr)
	local hum = getHum(plr)
	return hum and hum.Health > 0 and getRoot(plr) ~= nil
end

local function AddConnection(key, conn)
	if Runtime.Connections[key] then
		pcall(function() Runtime.Connections[key]:Disconnect() end)
	end
	Runtime.Connections[key] = conn
	return conn
end

local function RemoveConnection(key)
	if Runtime.Connections[key] then
		pcall(function() Runtime.Connections[key]:Disconnect() end)
		Runtime.Connections[key] = nil
	end
end

-- ============================================================
-- 4. CENTRALIZED SYNC CONTROLLER (Recursion-Safe)
-- ============================================================
local SyncManager = {
	_isSyncing = false,
	_watchers = {},
}

function SyncManager.RegisterWatcher(sourceModule, targetModule, propertyKey, syncCallback)
	local key = sourceModule .. "->" .. targetModule .. ":" .. propertyKey
	SyncManager._watchers[key] = {
		source = sourceModule,
		target = targetModule,
		prop = propertyKey,
		cb = syncCallback,
	}
end

function SyncManager.UnregisterWatcher(sourceModule, targetModule, propertyKey)
	if propertyKey then
		local key = sourceModule .. "->" .. targetModule .. ":" .. propertyKey
		SyncManager._watchers[key] = nil
	else
		-- Remove all watchers between these two modules
		for k, w in pairs(SyncManager._watchers) do
			if w.source == sourceModule and w.target == targetModule then
				SyncManager._watchers[k] = nil
			end
		end
	end
end

function SyncManager.NotifyChange(sourceModule, propertyKey, newValue)
	if SyncManager._isSyncing then return end
	SyncManager._isSyncing = true

	local ok, err = pcall(function()
		for _, w in pairs(SyncManager._watchers) do
			if w.source == sourceModule and w.prop == propertyKey then
				w.cb(newValue)
			end
		end
	end)

	SyncManager._isSyncing = false
	if not ok then warn("[SyncManager Error]", err) end
end

