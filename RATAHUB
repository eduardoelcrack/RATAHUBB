function Window:_select(id)
	if self._currentDropdownClose then
		self._currentDropdownClose()
	end
	if self._activeTab == id then return end
	self._activeTab = id
	self.gui:SetAttribute("ActiveTab", id)

	for tid, tab in pairs(self.tabs) do
		tab.page.Visible = (tid == id)
	end

	for tid, nb in pairs(self.navButtons) do
		local active = (tid == id)
		tween(nb.icon, HOVER, { TextColor3 = active and THEME.Primary or THEME.Muted })
		tween(nb.label, HOVER, { TextColor3 = active and THEME.Foreground or THEME.Muted })
		if active then tween(nb.button, HOVER, { BackgroundTransparency = 1 }) end
	end

	local nb = self.navButtons[id]
	if nb then
		self._highlight.Visible = true
		tween(self._highlight, SLIDE, { Position = UDim2.fromOffset(0, nb.index * NAV_ITEM_H) })
	end

	local tab = self.tabs[id]
	if tab then
		self._headerTitle.Text = tab.title
		self._headerSub.Text = tab.subtitle
	end
end

