local function CleanHitboxes()
	for part, originalSize in pairs(originalHitboxSizes) do
		if part and part.Parent then
			part.Size = originalSize
			part.Transparency = 0
		end
	end
	table.clear(originalHitboxSizes)
end

local function UpdateHitboxes()
	if not Config.Main.Player.HitboxEnabled then
		CleanHitboxes()
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local char = player.Character
			local targetPart = char:FindFirstChild(Config.Main.Player.HitboxPart) or char:FindFirstChild("Head")

			if ShouldTargetPlayer(player, Config.Main.Player.HitboxWhitelistMode, Config.Main.Player.HitboxTeamCheck, Config.Main.Player.HitboxFriendCheck) then
				if targetPart and targetPart:IsA("BasePart") then
					if not originalHitboxSizes[targetPart] then
						originalHitboxSizes[targetPart] = targetPart.Size
					end
					targetPart.Size = Vector3.new(Config.Main.Player.HitboxSize, Config.Main.Player.HitboxSize, Config.Main.Player.HitboxSize)
					targetPart.Transparency = Config.Main.Player.HitboxTransparency
					targetPart.CanCollide = false
				end
			else
				if targetPart and originalHitboxSizes[targetPart] then
					targetPart.Size = originalHitboxSizes[targetPart]
					targetPart.Transparency = 0
					originalHitboxSizes[targetPart] = nil
				end
			end
		end
	end
end

