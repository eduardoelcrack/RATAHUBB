-- 4. MATRIZ DE SINCRONIZACIÓN REVERSIBLE (Zero-Loop / True Disconnect)
--------------------------------------------------------------------------------
local SyncMatrix = {}
local UI_Controllers = {}

function SyncMatrix.Propagate(sourceName, propertyName, value)
	if isSyncUpdate then return end
	isSyncUpdate = true

	local syncMap = {
		ESP = {
			Aimlock = Config.ESP.SyncWithAimlock,
			Triggerbot = Config.ESP.SyncWithTriggerbot,
			Hitbox = Config.ESP.SyncWithHitbox
		},
		Aimlock = {
			ESP = Config.Aimlock.SyncWithESP,
			Triggerbot = Config.Aimlock.SyncWithTriggerbot,
			Hitbox = Config.Aimlock.SyncWithHitbox
		},
		Triggerbot = {
			ESP = Config.Triggerbot.SyncWithESP,
			Aimlock = Config.Triggerbot.SyncWithAimlock,
			Hitbox = Config.Triggerbot.SyncWithHitbox
		},
		Hitbox = {
			ESP = Config.Main.Player.HitboxSyncWithESP,
			Aimlock = Config.Main.Player.HitboxSyncWithAimlock,
			Triggerbot = Config.Main.Player.HitboxSyncWithTriggerbot
		}
	}

	local activeLinks = syncMap[sourceName]
	if activeLinks then
		for targetModule, isLinked in pairs(activeLinks) do
			if isLinked then
				if propertyName == "WhitelistMode" then
					if targetModule == "ESP" then
						Config.ESP.WhitelistMode = value
						if UI_Controllers.ESP and UI_Controllers.ESP.SetWhitelistMode then UI_Controllers.ESP.SetWhitelistMode(value) end
					elseif targetModule == "Aimlock" then
						Config.Aimlock.WhitelistMode = value
						if UI_Controllers.Aimlock and UI_Controllers.Aimlock.SetWhitelistMode then UI_Controllers.Aimlock.SetWhitelistMode(value) end
					elseif targetModule == "Triggerbot" then
						Config.Triggerbot.WhitelistMode = value
						if UI_Controllers.Triggerbot and UI_Controllers.Triggerbot.SetWhitelistMode then UI_Controllers.Triggerbot.SetWhitelistMode(value) end
					elseif targetModule == "Hitbox" then
						Config.Main.Player.HitboxWhitelistMode = value
						if UI_Controllers.Hitbox and UI_Controllers.Hitbox.SetWhitelistMode then UI_Controllers.Hitbox.SetWhitelistMode(value) end
					end
				end
			end
		end
	end

	isSyncUpdate = false
end

