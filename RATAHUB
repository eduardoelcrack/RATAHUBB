UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	-- Click TP (Evento puro de teleportación por CFrame)
	if Config.Extras.Tools.ClickTP and input.UserInputType == Enum.UserInputType.MouseButton1 then
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) or Config.Extras.Tools.ClickTP then
			local hitPos = Mouse.Hit and Mouse.Hit.Position
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if hitPos and root then
				root.CFrame = CFrame.new(hitPos + Vector3.new(0, 3, 0))
				Notify("Click TP", "Teletransportado exitosamente.", 1.5)
			end
		end
	end

	-- Keybind Fly
	if input.KeyCode == Config.Main.Movement.FlyKey then
		if Config.Main.Movement.FlyEnabled then
			if Config.Main.Movement.FlyActive then
				StopFly()
				Notify("Fly", "Vuelo Desactivado.", 1.5)
			else
				StartFly()
				Notify("Fly", "Vuelo Activado.", 1.5)
			end
		end
	end

	-- Keybind No Clip
	if input.KeyCode == Config.Main.Movement.NoclipKey then
		if Config.Main.Movement.NoclipEnabled then
			Config.Main.Movement.NoclipActive = not Config.Main.Movement.NoclipActive
			Notify("No Clip", Config.Main.Movement.NoclipActive and "No Clip Activado." or "No Clip Desactivado.", 1.5)
		end
	end

	-- Keybind Salto Infinito
	if input.KeyCode == Config.Main.Movement.InfiniteJumpKey then
		if Config.Main.Movement.InfiniteJumpEnabled then
			Config.Main.Movement.InfiniteJumpActive = not Config.Main.Movement.InfiniteJumpActive
			Notify("Infinite Jump", Config.Main.Movement.InfiniteJumpActive and "Salto Infinito Activado." or "Salto Infinito Desactivado.", 1.5)
		end
	end

	-- Keybind WalkSpeed
	if input.KeyCode == Config.Main.Movement.WalkSpeedKey then
		Config.Main.Movement.WalkSpeedActive = not Config.Main.Movement.WalkSpeedActive
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = Config.Main.Movement.WalkSpeedActive and Config.Main.Movement.WalkSpeed or 16
		end
		Notify("WalkSpeed", Config.Main.Movement.WalkSpeedActive and ("Velocidad (" .. Config.Main.Movement.WalkSpeed .. ") Activada.") or "Velocidad Normal.", 1.5)
	end

	-- Keybind Aimlock (Persistente + 3 Estados + Screen Space FOV)
	if input.KeyCode == Config.Aimlock.AimlockKey then
		if Config.Aimlock.Enabled then
			if Config.Aimlock.Active then
				Config.Aimlock.Active = false
				Config.Aimlock.Target = nil
				Notify("Aimlock", "Objetivo liberado.", 1.5)
			else
				-- Búsqueda de objetivo óptimo en Screen Space
				local bestTarget = nil
				local shortestDist = math.huge
				local mousePos = UserInputService:GetMouseLocation()

				for _, player in ipairs(Players:GetPlayers()) do
					if ShouldTargetPlayer(player, Config.Aimlock.WhitelistMode, Config.Aimlock.TeamCheck, Config.Aimlock.FriendCheck) then
						local char = player.Character
						local part = char and (
							Config.Aimlock.AimPart == "Head" and char:FindFirstChild("Head") or
							Config.Aimlock.AimPart == "Torso" and (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")) or
							char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
						)

						if part then
							local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
							if onScreen then
								local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
								local dist3D = (part.Position - Camera.CFrame.Position).Magnitude

								if dist3D <= Config.Aimlock.MaxDistance then
									if not Config.Aimlock.UseFOV or dist2D <= Config.Aimlock.FOVSize then
										if dist2D < shortestDist then
											shortestDist = dist2D
											bestTarget = player
										end
									end
								end
							end
						end
					end
				end

				if bestTarget then
					Config.Aimlock.Active = true
					Config.Aimlock.Target = bestTarget
					if Config.Sounds.LockSound then
						PlayAudio(Config.Sounds.SoundList[Config.Sounds.SelectedSound])
					end
					Notify("Aimlock", "Lockeaste a " .. bestTarget.Name, 2.5)
				else
					Notify("Aimlock", "No se encontró ningún objetivo válido.", 2)
				end
			end
		end
	end
end)

