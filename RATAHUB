-- RAYFIELD COMPATIBILITY ADAPTER
--=====================================================================
local RATAHUBAdapter = {}
RATAHUBAdapter.__index = RATAHUBAdapter

function RATAHUBAdapter.wrap(window)
	return setmetatable({ _window = window }, RATAHUBAdapter)
end

function RATAHUBAdapter:CreateWindow(_)
	return self
end

function RATAHUBAdapter:CreateTab(name, icon)
	local tab = self._window:CreateTab({ Name = name, Icon = icon, SubTitle = name })
	return setmetatable({ _tab = tab }, {
		__index = {
			CreateSection = function(_, t) return tab:CreateSection(t) end,
			CreateDivider = function(_) return tab:CreateDivider() end,
			CreateParagraph = function(_, c)
				c = c or {}
				return tab:CreateParagraph({ Title = c.Title, Content = c.Content })
			end,
			CreateLabel = function(_, c)
				local text = type(c) == "table" and c.Text or c
				return tab:CreateLabel({ Text = text })
			end,
			CreateButton = function(_, c)
				c = c or {}
				return tab:CreateButton({
					Name = c.Name, Callback = c.Callback, Destructive = c.Destructive,
				})
			end,
			CreateToggle = function(_, c)
				c = c or {}
				return tab:CreateToggle({
					Name = c.Name, Description = c.Description,
					CurrentValue = c.CurrentValue, Callback = c.Callback,
				})
			end,
			CreateSlider = function(_, c)
				c = c or {}
				return tab:CreateSlider({
					Name = c.Name, Range = c.Range, Increment = c.Increment,
					CurrentValue = c.CurrentValue, Suffix = c.Suffix, Callback = c.Callback,
				})
			end,
			CreateDropdown = function(_, c)
				c = c or {}
				return tab:CreateDropdown({
					Name = c.Name, Options = c.Options,
					CurrentOption = c.CurrentOption or (c.Options and c.Options[1]),
					Callback = c.Callback,
				})
			end,
			CreateKeybind = function(_, c)
				c = c or {}
				return tab:CreateKeybind({
					Name = c.Name, CurrentKeybind = c.CurrentKeybind, Callback = c.Callback,
				})
			end,
			CreateInput = function(_, c)
				c = c or {}
				return tab:CreateInput({
					Name = c.Name, PlaceholderText = c.PlaceholderText,
					CurrentValue = c.CurrentValue, Callback = c.Callback,
				})
			end,
			CreateColorPicker = function(_, c)
				c = c or {}
				return tab:CreateColorPicker({
					Name = c.Name, Color = c.Color, Callback = c.Callback,
				})
			end,
		},
	})
end

function RATAHUBAdapter:Notify(cfg)
	return RATAHUB:Notify(cfg)
end

