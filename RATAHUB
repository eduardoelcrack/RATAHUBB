				local btnAbsSize = btn.AbsoluteSize

				local relX = btnAbsPos.X - winAbsPos.X
				local relY = btnAbsPos.Y - winAbsPos.Y + btnAbsSize.Y + 4

				local targetH = math.min(#options, 6) * 28 + 8
				popup.Position = UDim2.fromOffset(relX, relY)
				popup.Size = UDim2.fromOffset(btnAbsSize.X, targetH)
			end

			local function closePopup()
				if not isOpen then return end
				isOpen = false
				popup.Visible = false
				arrow.Text = "▾"
				if windowInstance._activeDropdownClose == closePopup then
					windowInstance._activeDropdownClose = nil
				end
			end

			local function refreshOptionItems()
				for _, ch in ipairs(popupScroll:GetChildren()) do
					if ch:IsA("TextButton") then ch:Destroy() end
				end

				for _, opt in ipairs(options) do
					local optBtn = create("TextButton", {
						Size = UDim2.new(1, 0, 0, 26),
						BackgroundColor3 = THEME.Secondary,
						BackgroundTransparency = 1,
						Text = "",
						AutoButtonColor = false,
						ZIndex = 86,
						Parent = popupScroll,
					})
					corner(6, optBtn)
					padding(optBtn, nil, 8, 0)

					local isSel = isMulti and (selectedMulti[opt] == true) or (selectedSingle == opt)

					local optLabel = create("TextLabel", {
						Size = UDim2.new(1, -20, 1, 0),
						BackgroundTransparency = 1,
						Text = opt,
						TextColor3 = isSel and THEME.Primary or THEME.Foreground,
						TextXAlignment = Enum.TextXAlignment.Left,
						Font = isSel and FONT_BOLD or FONT,
						TextSize = 12,
						ZIndex = 87,
						Parent = optBtn,
					})

					local checkMark = create("TextLabel", {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, 0, 0.5, 0),
						Size = UDim2.fromOffset(14, 14),
						BackgroundTransparency = 1,
						Text = isSel and "✓" or "",
						TextColor3 = THEME.Primary,
						Font = FONT_BOLD,
						TextSize = 12,
						ZIndex = 87,
						Parent = optBtn,
					})

					optBtn.MouseButton1Click:Connect(function()
						if isMulti then
							selectedMulti[opt] = not selectedMulti[opt]
							if not selectedMulti[opt] then selectedMulti[opt] = nil end
							btnText.Text = getDisplayText()
							refreshOptionItems()
							cb(selectedMulti)
						else
							selectedSingle = opt
							btnText.Text = getDisplayText()
							closePopup()
							cb(selectedSingle)
						end
					end)
				end
			end

			local function openPopup()
				if windowInstance._activeDropdownClose then
					windowInstance._activeDropdownClose()
				end
				isOpen = true
				refreshOptionItems()
				repositionPopup()
				popup.Visible = true
				arrow.Text = "▴"
				windowInstance._activeDropdownClose = closePopup
			end

			btn.MouseButton1Click:Connect(function()
				if isOpen then closePopup() else openPopup() end
			end)

			return {
				Set = function(_, val)
					if isMulti then
						selectedMulti = {}
						if type(val) == "table" then
							for k, v in pairs(val) do
								if type(k) == "string" and v == true then
									selectedMulti[k] = true
								elseif type(v) == "string" then
									selectedMulti[v] = true
								end
							end
						elseif type(val) == "string" and val ~= "" and val ~= "Nadie" then
							selectedMulti[val] = true
						end
					else
						selectedSingle = val or ""
					end
					btnText.Text = getDisplayText()
					if isOpen then refreshOptionItems() end
				end,
				Refresh = function(_, newOptions, defaultOption)
					options = newOptions or {}
					if isMulti then
						selectedMulti = {}
						if defaultOption then
							if type(defaultOption) == "table" then
								for _, v in ipairs(defaultOption) do selectedMulti[v] = true end
							elseif type(defaultOption) == "string" and defaultOption ~= "" and defaultOption ~= "Nadie" then
								selectedMulti[defaultOption] = true
							end
						end
					else
						selectedSingle = defaultOption or options[1] or ""
					end
					btnText.Text = getDisplayText()
					if isOpen then
						refreshOptionItems()
						repositionPopup()
					end
				end,
				GetValue = function()
					return isMulti and selectedMulti or selectedSingle
				end,
			}
		end

