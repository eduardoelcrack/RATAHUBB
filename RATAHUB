		end

		-- WalkSpeed Keybind
		if Config.Main.WalkSpeed and input.KeyCode.Name == Config.Main.WalkSpeedKeybind then
			State.Main.WalkSpeedActive = not State.Main.WalkSpeedActive
			Features.ApplyWalkSpeed()
			RATAHUB:Notify({ Title = "WalkSpeed", Content = State.Main.WalkSpeedActive and "Activado" or "Desactivado", Duration = 1.2 })
		end

		-- JumpPower Keybind
		if Config.Main.JumpPower and input.KeyCode.Name == Config.Main.JumpPowerKeybind then
			State.Main.JumpPowerActive = not State.Main.JumpPowerActive
			Features.ApplyJumpPower()
			RATAHUB:Notify({ Title = "JumpPower", Content = State.Main.JumpPowerActive and "Activado" or "Desactivado", Duration = 1.2 })
		end

		-- Gravity Keybind
		if Config.Main.Gravity and input.KeyCode.Name == Config.Main.GravityKeybind then
			State.Main.GravityActive = not State.Main.GravityActive
			Features.ApplyGravity()
			RATAHUB:Notify({ Title = "Gravity", Content = State.Main.GravityActive and "Activado" or "Desactivado", Duration = 1.2 })
		end

		-- Infinite Jump Keybind
		if Config.Main.InfiniteJump and input.KeyCode.Name == Config.Main.InfiniteJumpKeybind then
			State.Main.InfiniteJumpActive = not State.Main.InfiniteJumpActive
			if State.Main.InfiniteJumpActive then
