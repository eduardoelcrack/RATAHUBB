-- 16. PLAYER & TEAM DYNAMIC LIFECYCLE LISTENERS
-- ============================================================
Players.PlayerAdded:Connect(function(newPlr)
	newPlr.CharacterAdded:Connect(function()
		task.wait(0.5)
		if Config.Main.HitboxExpander then Features.UpdateHitboxes() end
		if Config.ESP.Highlight or Config.ESP.Names or Config.ESP.Details or Config.ESP.Tracers then Features.UpdateESP() end
	end)
	RefreshAllPlayerDropdowns()
end)

Players.PlayerRemoving:Connect(function(leavingPlr)
	if Runtime.ESP.objects[leavingPlr] then
		local obj = Runtime.ESP.objects[leavingPlr]
		if obj.Highlight then obj.Highlight:Destroy() end
		if obj.Billboard then obj.Billboard:Destroy() end
		if obj.TracerLine then obj.TracerLine:Destroy() end
		Runtime.ESP.objects[leavingPlr] = nil
	end
	Runtime.Hitbox.origs[leavingPlr] = nil
	friendCache[leavingPlr.UserId] = nil

	if State.Aimlock.Target == leavingPlr then
		local tName = leavingPlr.Name
		State.Aimlock.Active = false
		State.Aimlock.Target = nil
		RATAHUB:Notify({ Title = "Aimlock", Content = tName .. " se salió/desapareció", Duration = 2.0 })
	end

	RefreshAllPlayerDropdowns()
end)

pcall(function()
	Teams.ChildAdded:Connect(function() task.wait(0.2) RefreshAllTeamDropdowns() end)
	Teams.ChildRemoved:Connect(function() task.wait(0.2) RefreshAllTeamDropdowns() end)
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)
	if State.Main.WalkSpeedActive and Config.Main.WalkSpeed then Features.ApplyWalkSpeed() end
	if State.Main.JumpPowerActive and Config.Main.JumpPower then Features.ApplyJumpPower() end
	if State.Main.GravityActive and Config.Main.Gravity then Features.ApplyGravity() end
	if State.Main.NoclipActive and Config.Main.Noclip then Features.StartNoclip() end
	if State.Main.FlyActive and Config.Main.Fly then Features.StartFly() end
	if Config.Extras.Vision.XRay then Features.SetXRay(true) end
end)

