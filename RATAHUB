-- 12. GESTIÓN DINÁMICA DE JUGADORES Y EVENTOS DE ENTORNO
--------------------------------------------------------------------------------
local function RefreshAllWhitelistDropdowns()
	local names = GetPlayerList()
	if hitboxWhitelistSelectDropdown then hitboxWhitelistSelectDropdown.Refresh(names) end
	if espWhitelistSelectDropdown then espWhitelistSelectDropdown.Refresh(names) end
	if aimlockWhitelistSelectDropdown then aimlockWhitelistSelectDropdown.Refresh(names) end
	if triggerWhitelistSelectDropdown then triggerWhitelistSelectDropdown.Refresh(names) end
end

Players.PlayerAdded:Connect(function(player)
	RefreshAllWhitelistDropdowns()
end)

Players.PlayerRemoving:Connect(function(player)
	GlobalWhitelistTable[player.Name] = nil
	if Config.Aimlock.Target == player then
		Config.Aimlock.Active = false
		Config.Aimlock.Target = nil
		Notify("Aimlock", player.Name .. " se salió/desapareció", 2.5)
	end
	RefreshAllWhitelistDropdowns()
end)

Notify("RATAHUB V5", "Suite Premium cargada exitosamente.", 4)
