-- Freecam (Range 1-100, Inc 1, Init 10)
function Features.StartFreecam()
	if Runtime.Camera.freecamLoop then return end
	local cam = workspace.CurrentCamera
	if not cam then return end

	local root = getRoot()
	if root then
		Runtime.Camera.wasAnchored = root.Anchored
		root.Anchored = true
	end

	Runtime.Camera.savedType = cam.CameraType
	Runtime.Camera.savedSubject = cam.CameraSubject
	cam.CameraType = Enum.CameraType.Scriptable

	local keys = Runtime.Camera.keys
	table.clear(keys)

	Runtime.Camera.freecamBegan = UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			keys[input.KeyCode] = true
		end
	end)

	Runtime.Camera.freecamEnded = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			keys[input.KeyCode] = nil
		end
	end)

	Runtime.Camera.freecamLoop = RunService.RenderStepped:Connect(function(dt)
		if not State.Extras.FreecamActive or not Config.Extras.Camera.Freecam then
			Features.StopFreecam()
			return
		end

		local speed = (Config.Extras.Camera.FreecamSpeed or 10) * 50 * dt
		local cframe = cam.CFrame
		local moveDir = Vector3.zero

		if keys[Enum.KeyCode.W] then moveDir = moveDir + cframe.LookVector end
		if keys[Enum.KeyCode.S] then moveDir = moveDir - cframe.LookVector end
		if keys[Enum.KeyCode.A] then moveDir = moveDir - cframe.RightVector end
		if keys[Enum.KeyCode.D] then moveDir = moveDir + cframe.RightVector end
		if keys[Enum.KeyCode.E] or keys[Enum.KeyCode.Space] then moveDir = moveDir + Vector3.new(0, 1, 0) end
		if keys[Enum.KeyCode.Q] or keys[Enum.KeyCode.LeftControl] then moveDir = moveDir - Vector3.new(0, 1, 0) end

		if moveDir.Magnitude > 0 then
			cam.CFrame = cframe + (moveDir.Unit * speed)
		end
	end)
end

function Features.StopFreecam()
	if Runtime.Camera.freecamLoop then
		Runtime.Camera.freecamLoop:Disconnect()
		Runtime.Camera.freecamLoop = nil
	end
	if Runtime.Camera.freecamBegan then
		Runtime.Camera.freecamBegan:Disconnect()
		Runtime.Camera.freecamBegan = nil
	end
	if Runtime.Camera.freecamEnded then
		Runtime.Camera.freecamEnded:Disconnect()
		Runtime.Camera.freecamEnded = nil
	end

	local cam = workspace.CurrentCamera
	if cam and Runtime.Camera.savedType then
		cam.CameraType = Runtime.Camera.savedType
		cam.CameraSubject = Runtime.Camera.savedSubject
	end

	local root = getRoot()
	if root then
		root.Anchored = Runtime.Camera.wasAnchored or false
	end
end

