-- Hitbox Expander
function Features.UpdateHitboxes()
	local isEnabled = Config.Main.HitboxExpander
	local sizeVal = Config.Main.HitboxSize
	local mode = Config.Main.HitboxWhitelistMode
	local targetSel = Config.Main.HitboxTarget

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local root = p.Character:FindFirstChild("HumanoidRootPart")
			if root then
				if not Runtime.Hitbox.origs[p] then
					Runtime.Hitbox.origs[p] = {
						Size = root.Size,
						Transparency = root.Transparency,
						CanCollide = root.CanCollide,
					}
				end

				local orig = Runtime.Hitbox.origs[p]
				local valid = isEnabled and Features.IsWhitelisted(p, mode, targetSel)

				if valid and isAlive(p) then
					root.Size = Vector3.new(sizeVal, sizeVal, sizeVal)
					root.Transparency = 0.65
					root.CanCollide = false
				else
					root.Size = orig.Size
					root.Transparency = orig.Transparency
					root.CanCollide = orig.CanCollide
				end
			end
		end
	end
end

function Features.RestoreHitboxes()
	for p, orig in pairs(Runtime.Hitbox.origs) do
		if p and p.Character then
			local root = p.Character:FindFirstChild("HumanoidRootPart")
			if root then
				root.Size = orig.Size
				root.Transparency = orig.Transparency
				root.CanCollide = orig.CanCollide
			end
		end
	end
	table.clear(Runtime.Hitbox.origs)
end

