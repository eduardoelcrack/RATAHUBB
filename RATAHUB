-- 5. GAME FILTERING & TEAM / FRIEND LOGIC
-- ============================================================
local Features = {}
local friendCache = {}

function Features.IsFriend(targetPlayer)
	if not targetPlayer or targetPlayer == LocalPlayer then return false end
	if friendCache[targetPlayer.UserId] ~= nil then
		return friendCache[targetPlayer.UserId]
	end
	local success, isFr = pcall(function()
		return LocalPlayer:IsFriendsWith(targetPlayer.UserId)
	end)
	if success then
		friendCache[targetPlayer.UserId] = isFr
		return isFr
	end
	return false
end

function Features.IsSameTeam(targetPlayer)
	if not targetPlayer or targetPlayer == LocalPlayer then return true end
	local lpTeam = LocalPlayer.Team
	local tpTeam = targetPlayer.Team
	if lpTeam and tpTeam then
		return lpTeam == tpTeam
	end
	if LocalPlayer.TeamColor and targetPlayer.TeamColor then
		return LocalPlayer.TeamColor == targetPlayer.TeamColor
	end
	return false
end

function Features.IsTeamIgnored(targetPlayer, ignoredTeamName)
	if not targetPlayer or not ignoredTeamName or ignoredTeamName == "Ninguno" then return false end
	if targetPlayer.Team and targetPlayer.Team.Name == ignoredTeamName then
		return true
	end
	return false
end

function Features.IsWhitelisted(targetPlayer, moduleMode, moduleTarget)
	if not targetPlayer or targetPlayer == LocalPlayer then return false end
	if moduleMode == "Disabled" then
		return true -- Whitelist filter is disabled; everyone is allowed
	end

	local name = targetPlayer.Name
	local isSelected = false

	if type(moduleTarget) == "table" then
		isSelected = moduleTarget[name] == true
	elseif type(moduleTarget) == "string" then
		isSelected = (moduleTarget == name or moduleTarget == "Todos")
	end

	-- Also check global whitelist if in synced mode or selected
	if not isSelected and GlobalWhitelistTable[name] then
		isSelected = true
	end

	if moduleMode == "Only Whitelist" then
		return isSelected
	elseif moduleMode == "Ignore Whitelist" then
		return not isSelected
	end

	return true
end

function Features.PlaySound(soundKey)
	local soundId = SOUND_IDS[soundKey] or SOUND_IDS["Ping"]
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = 1
	sound.Parent = SoundService
	sound.PlayOnRemove = true
	sound:Destroy()
end

