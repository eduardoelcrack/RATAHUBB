		-- Componente: CreateDropdown (Floating Overlay Portal, MultiSelect y Single-Select)
		function TabAPI:CreateDropdown(opts)
			opts = opts or {}
			local name = opts.Name or "Dropdown"
			local options = opts.Options or {}
			local isMulti = opts.MultiSelect or false
			local currentSelection = opts.CurrentOption or (isMulti and {} or options[1])
			local callback = opts.Callback or function() end

			local frame = Instance.new("Frame")
			frame.Size = UDim2.new(1, 0, 0, 36)
			frame.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
			frame.BorderSizePixel = 0
			frame.Parent = tabScroll

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 6)
			corner.Parent = frame

			local label = Instance.new("TextLabel")
			label.Text = name
			label.TextColor3 = Color3.fromRGB(220, 220, 230)
			label.TextSize = 12
			label.Font = Enum.Font.Gotham
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Position = UDim2.new(0, 12, 0, 0)
			label.Size = UDim2.new(0.5, -12, 1, 0)
			label.BackgroundTransparency = 1
			label.Parent = frame

			local trigger = Instance.new("TextButton")
			trigger.Size = UDim2.new(0.5, -12, 0, 24)
			trigger.Position = UDim2.new(0.5, 0, 0.5, -12)
			trigger.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
			trigger.Font = Enum.Font.Gotham
			trigger.TextSize = 11
			trigger.TextColor3 = Color3.fromRGB(200, 200, 215)
			trigger.Parent = frame

			local triggerCorner = Instance.new("UICorner")
			triggerCorner.CornerRadius = UDim.new(0, 4)
			triggerCorner.Parent = trigger

			local function UpdateTriggerText()
				if isMulti then
					local count = 0
					for _ in pairs(currentSelection) do count = count + 1 end
					trigger.Text = count == 0 and "Ninguno" or (count .. " Seleccionado(s)")
				else
					trigger.Text = tostring(currentSelection)
				end
			end
			UpdateTriggerText()

			-- Menú flotante Overlay
			local menuFrame = Instance.new("Frame")
			menuFrame.Size = UDim2.new(0, 190, 0, 140)
			menuFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
			menuFrame.BorderSizePixel = 0
			menuFrame.Visible = false
			menuFrame.ZIndex = 200
			menuFrame.Parent = overlayGui

			local menuCorner = Instance.new("UICorner")
			menuCorner.CornerRadius = UDim.new(0, 6)
			menuCorner.Parent = menuFrame

			local menuStroke = Instance.new("UIStroke")
			menuStroke.Color = Color3.fromRGB(48, 48, 62)
			menuStroke.Thickness = 1
			menuStroke.Parent = menuFrame

			local menuScroll = Instance.new("ScrollingFrame")
			menuScroll.Size = UDim2.new(1, 0, 1, 0)
			menuScroll.BackgroundTransparency = 1
			menuScroll.ScrollBarThickness = 2
			menuScroll.ScrollBarImageColor3 = Color3.fromRGB(70, 70, 90)
			menuScroll.Parent = menuFrame

			local menuLayout = Instance.new("UIListLayout")
			menuLayout.SortOrder = Enum.SortOrder.LayoutOrder
			menuLayout.Padding = UDim.new(0, 2)
			menuLayout.Parent = menuScroll

			local function RebuildOptions()
				for _, child in ipairs(menuScroll:GetChildren()) do
					if child:IsA("TextButton") then child:Destroy() end
				end

				for _, optName in ipairs(options) do
					local optBtn = Instance.new("TextButton")
					optBtn.Size = UDim2.new(1, -4, 0, 24)
					optBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
					optBtn.Text = optName
					optBtn.Font = Enum.Font.Gotham
					optBtn.TextSize = 11

					if isMulti then
						optBtn.TextColor3 = currentSelection[optName] and Color3.fromRGB(140, 100, 255) or Color3.fromRGB(180, 180, 195)
					else
						optBtn.TextColor3 = (currentSelection == optName) and Color3.fromRGB(140, 100, 255) or Color3.fromRGB(180, 180, 195)
					end
					optBtn.Parent = menuScroll

					local optCorner = Instance.new("UICorner")
					optCorner.CornerRadius = UDim.new(0, 4)
					optCorner.Parent = optBtn

					optBtn.MouseButton1Click:Connect(function()
						if isMulti then
							if currentSelection[optName] then
								currentSelection[optName] = nil
							else
								currentSelection[optName] = true
							end
							UpdateTriggerText()
							RebuildOptions()
							callback(currentSelection)
						else
							currentSelection = optName
							UpdateTriggerText()
							menuFrame.Visible = false
							callback(currentSelection)
						end
					end)
				end
				menuScroll.CanvasSize = UDim2.new(0, 0, 0, #options * 26)
			end

			trigger.MouseButton1Click:Connect(function()
				menuFrame.Visible = not menuFrame.Visible
				if menuFrame.Visible then
					local absPos = trigger.AbsolutePosition
					menuFrame.Position = UDim2.new(0, absPos.X, 0, absPos.Y + trigger.AbsoluteSize.Y + 4)
					RebuildOptions()
				end
			end)

			return {
				Set = function(val)
					currentSelection = val
					UpdateTriggerText()
					RebuildOptions()
					callback(currentSelection)
				end,
				Refresh = function(newOpts)
					options = newOpts
					RebuildOptions()
				end
			}
		end

		return TabAPI
	end

	return RataHub
end

