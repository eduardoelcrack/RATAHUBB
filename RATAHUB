			local function getDisplayText()
				if isMulti then
					local count = 0
					local last = ""
					for k, v in pairs(selectedMulti) do
						if v then count = count + 1 last = k end
					end
					if count == 0 then return "Nadie" end
					if count == 1 then return last end
					return count .. " seleccionados"
				else
					return tostring(selectedSingle)
				end
			end

			btnText.Text = getDisplayText()

			-- Floating Overlay List Frame
			local popup = create("Frame", {
				BackgroundColor3 = THEME.Panel,
				Size = UDim2.fromOffset(180, 0),
