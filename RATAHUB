function Features.UpdateAimlockLoop()
	if Runtime.Aimlock.loop then
		Runtime.Aimlock.loop:Disconnect()
		Runtime.Aimlock.loop = nil
	end

	Runtime.Aimlock.loop = RunService.RenderStepped:Connect(function()
		local aimCfg = Config.Aimlock
		local cam = workspace.CurrentCamera
		if not cam then return end

		-- FOV Circle Visualizer (rendered behind GUI)
		if aimCfg.Enabled and aimCfg.UseFOV then
			if not Runtime.Aimlock.fovCircle then
				Runtime.Aimlock.fovCircle = create("Frame", {
					Name = "RATAHUB_FOVCircle",
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundTransparency = 1,
					ZIndex = 2,
					Parent = screenGui,
				})
				corner(999, Runtime.Aimlock.fovCircle)
				stroke(Runtime.Aimlock.fovCircle, 0.5, THEME.Primary, 1.5)
			end
			local mPos = UserInputService:GetMouseLocation()
			Runtime.Aimlock.fovCircle.Position = UDim2.fromOffset(mPos.X, mPos.Y)
			Runtime.Aimlock.fovCircle.Size = UDim2.fromOffset(aimCfg.FOVSize * 2, aimCfg.FOVSize * 2)
			Runtime.Aimlock.fovCircle.Visible = true
		else
			if Runtime.Aimlock.fovCircle then
				Runtime.Aimlock.fovCircle.Visible = false
			end
		end

		-- Persistent Target Processing
		if State.Aimlock.Active and State.Aimlock.Target then
			local target = State.Aimlock.Target

			-- Validation check 1: Still in game?
			if not target.Parent or not Players:FindFirstChild(target.Name) then
				local tName = target.Name
				State.Aimlock.Active = false
				State.Aimlock.Target = nil
				RATAHUB:Notify({ Title = "Aimlock", Content = tName .. " se salió/desapareció", Duration = 2.0 })
				return
			end

			-- Validation check 2: Character and RootPart exist?
			local char = target.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if not char or not root or not hum then
				local tName = target.Name
				State.Aimlock.Active = false
				State.Aimlock.Target = nil
				RATAHUB:Notify({ Title = "Aimlock", Content = tName .. " se salió/desapareció", Duration = 2.0 })
				return
			end

			-- Validation check 3: Health > 0?
			if hum.Health <= 0 then
				local tName = target.Name
				State.Aimlock.Active = false
				State.Aimlock.Target = nil
				RATAHUB:Notify({ Title = "Aimlock", Content = tName .. " se murió", Duration = 2.0 })
				return
			end

			-- Valid target: Calculate lock position and lerp camera
			local aimPart = char:FindFirstChild(aimCfg.AimPart) or root
			local targetPos = aimPart.Position

			if aimCfg.Prediction and root.Velocity then
				targetPos = targetPos + (root.Velocity * aimCfg.PredictionTime)
			end

			local smoothAlpha = clamp(1 - (aimCfg.Smoothness / 100), 0.05, 1)
			cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, targetPos), smoothAlpha)

			-- Aimlock Enemy Tracer (Mutually exclusive with ESP Tracer)
			if aimCfg.EnemyTracers and not Config.ESP.Tracers then
				local screenPos, onScreen = cam:WorldToViewportPoint(targetPos)
				if onScreen then
					if not Runtime.Aimlock.tracerLine then
						Runtime.Aimlock.tracerLine = create("Frame", {
							Name = "Aimlock_Tracer",
							BorderSizePixel = 0,
							AnchorPoint = Vector2.new(0.5, 0.5),
							BackgroundColor3 = ESP_RED,
							ZIndex = 2,
							Parent = screenGui,
						})
					end

					local fromPos
					if aimCfg.TracerOrigin == "Bottom" then
						fromPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
					elseif aimCfg.TracerOrigin == "Center" then
						fromPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
					else
						local mPos = UserInputService:GetMouseLocation()
						fromPos = Vector2.new(mPos.X, mPos.Y)
					end

					local toPos = Vector2.new(screenPos.X, screenPos.Y)
					local dist2D = (toPos - fromPos).Magnitude
					local center = (fromPos + toPos) / 2
					local angle = math.atan2(toPos.Y - fromPos.Y, toPos.X - fromPos.X)

					Runtime.Aimlock.tracerLine.Size = UDim2.fromOffset(dist2D, 1.5)
					Runtime.Aimlock.tracerLine.Position = UDim2.fromOffset(center.X, center.Y)
					Runtime.Aimlock.tracerLine.Rotation = math.deg(angle)
					Runtime.Aimlock.tracerLine.Visible = true
				else
					if Runtime.Aimlock.tracerLine then Runtime.Aimlock.tracerLine.Visible = false end
				end
			else
				if Runtime.Aimlock.tracerLine then Runtime.Aimlock.tracerLine.Visible = false end
			end
		else
			if Runtime.Aimlock.tracerLine then Runtime.Aimlock.tracerLine.Visible = false end
		end
	end)
end

