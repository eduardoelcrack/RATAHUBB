	if Runtime.Noclip.addedConn then Runtime.Noclip.addedConn:Disconnect() Runtime.Noclip.addedConn = nil end
	for part, state in pairs(Runtime.Noclip.original) do
		if part and part.Parent then part.CanCollide = state end
	end
	table.clear(Runtime.Noclip.original)
	table.clear(Runtime.Noclip.cache)
end

function Features.StartNoclip()
	Features.StopNoclip()
	local char = getChar()
	if not char then return end
	for _, part in pairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			table.insert(Runtime.Noclip.cache, part)
			if Runtime.Noclip.original[part] == nil then Runtime.Noclip.original[part] = part.CanCollide end
		end
	end
	Runtime.Noclip.addedConn = char.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then
			table.insert(Runtime.Noclip.cache, part)
			if Runtime.Noclip.original[part] == nil then Runtime.Noclip.original[part] = part.CanCollide end
		end
	end)
	Runtime.Noclip.stepConn = RunService.Stepped:Connect(function()
		if Config.Main.Movement.Noclip and Config.Main.Movement.NoclipActive then
			for _, part in ipairs(Runtime.Noclip.cache) do
				if part and part.Parent then part.CanCollide = false end
			end
		end
	end)
end

