	-- Sistema de Resize de 4 Esquinas Sin Deriva
	local function CreateResizeGrip(name, anchor, pos, scaleX, scaleY)
		local grip = Instance.new("TextButton")
		grip.Name = name
		grip.Size = UDim2.new(0, 10, 0, 10)
		grip.AnchorPoint = anchor
		grip.Position = pos
