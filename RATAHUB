	if Runtime.Aimlock.loop then Runtime.Aimlock.loop:Disconnect() Runtime.Aimlock.loop = nil end
	if Runtime.Triggerbot.loop then Runtime.Triggerbot.loop:Disconnect() Runtime.Triggerbot.loop = nil end

	-- 2. Restore character physics and camera
	local hum = getHum()
	if hum then
		hum.WalkSpeed = 16
		hum.JumpPower = 50
	end
	workspace.Gravity = 196.2

	local cam = workspace.CurrentCamera
	if cam then
		cam.FieldOfView = DEFAULT_FOV
		cam.CameraType = Enum.CameraType.Custom
	end

	-- 3. Destroy GUI
	if screenGui then
		screenGui:Destroy()
		screenGui = nil
	end
end

