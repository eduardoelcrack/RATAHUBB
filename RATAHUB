			VirtualUser:CaptureController()
			VirtualUser:Button1Down(Vector2.new(mouse.X, mouse.Y))
			task.wait(trigCfg.Delay or 0.1)
			VirtualUser:Button1Up(Vector2.new(mouse.X, mouse.Y))
		end
	end)
end

