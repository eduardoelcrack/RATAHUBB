	Callback = function(enabled)
		Config.Troll.Fling = enabled
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if enabled and root then
			local bVelocity = Instance.new("BodyAngularVelocity")
			bVelocity.Name = "FlingForce"
			bVelocity.AngularVelocity = Vector3.new(0, 99999, 0)
			bVelocity.MaxTorque = Vector3.new(0, 9e9, 0)
			bVelocity.P = 9e4
			bVelocity.Parent = root
		elseif root and root:FindFirstChild("FlingForce") then
			root.FlingForce:Destroy()
		end
	end
})

TrollTab:CreateToggle({
	Name = "Invisibilidad (Local / Visual)",
	CurrentValue = false,
	Callback = function(enabled)
		Config.Troll.Invisible = enabled
		local char = LocalPlayer.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") or part:IsA("Decal") then
					part.Transparency = enabled and 1 or 0
				end
			end
		end
	end
})

