function DestroyHubCompletely()
	StopFly()
	StopWalkSpeedLoop()
	StopJumpPowerLoop()
	StopGravityLoop()
	stopNoclip()

	DestroyWatermark()

	getgenv().HBE = false
	ToggleHBELoops(false)

	StopAimlock()

	ToggleFOVLoop(false)
	pcall(function()
		if FOVCircle then
			FOVCircle:Remove()
			FOVCircle = nil
		end
	end)

	UpdateTracersState(false)
	UpdateAimTracersState(false)

	RainbowESPEnabled = false
	if RainbowLoop then
		RainbowLoop:Disconnect()
		RainbowLoop = nil
	end

	SetupHighlightESP(false)
	SetupNameESP(false)
	ToggleESPStuds(false)

	ToggleFOVChanger(false)
	ToggleFreecam(false)
	ToggleFullbright(false)
	ToggleXRay(false)

	if AntiAFKConn then
		AntiAFKConn:Disconnect()
		AntiAFKConn = nil
	end

	-- Quitar herramientas creadas por el hub
	pcall(function()
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		if backpack then
			local clickTP = backpack:FindFirstChild("Click TP")
			if clickTP then clickTP:Destroy() end

			local btools = backpack:FindFirstChild("BTools")
			if btools then btools:Destroy() end
		end

		local char = LocalPlayer.Character
		if char then
			local clickTP = char:FindFirstChild("Click TP")
			if clickTP then clickTP:Destroy() end

			local btools = char:FindFirstChild("BTools")
			if btools then btools:Destroy() end
		end
	end)

	Rayfield:Destroy()
end

