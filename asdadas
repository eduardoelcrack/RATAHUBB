-- ║               SISTEMA DE WHITELIST MULTI                ║
-- ╚══════════════════════════════════════════════════════════╝
local GlobalWhitelistTable = {}
local function IsInWhitelist(plrName)
	if type(GlobalWhitelistTable) == "table" then
		for _, name in pairs(GlobalWhitelistTable) do
			if name == plrName then return true end
		end
	elseif type(GlobalWhitelistTable) == "string" then
		return GlobalWhitelistTable == plrName
	end
	return false
end
local function ShouldTargetPlayer(plr, mode)
	if not plr or plr == LocalPlayer then return false end
	
	-- Filtro 1: Team Check (Ignorar Equipos)
	if IsTeamIgnored(plr) then return false end
	-- Filtro 2: Whitelist
	if mode and mode ~= "Disabled" then
		local isWhitelisted = IsInWhitelist(plr.Name)
		if mode == "Ignore Whitelist" and isWhitelisted then
			return false
		elseif mode == "Only Whitelist" and not isWhitelisted then
			return false
		end
	end
	return true
end
