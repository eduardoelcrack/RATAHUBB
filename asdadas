local function IsAlive(plr)
	return plr and plr.Character
		and plr.Character:FindFirstChildOfClass("Humanoid")
		and plr.Character:FindFirstChildOfClass("Humanoid").Health > 0
end
local function IsSameTeam(plr)
	if not plr or plr == LocalPlayer then return true end
	if plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return true end
	return false
end
local IgnoredTeamsTable = {}
local AllTeamDropdowns   = {}
local function IsTeamIgnored(plr)
	if not plr or not plr.Team then return false end
	if type(IgnoredTeamsTable) == "table" then
		for _, name in pairs(IgnoredTeamsTable) do
			if name == plr.Team.Name then return true end
		end
	elseif type(IgnoredTeamsTable) == "string" then
		return IgnoredTeamsTable == plr.Team.Name
	end
	return false
end
