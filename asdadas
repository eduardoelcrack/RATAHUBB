local function RestoreHitbox(plr)
	local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if hrp and OriginalSizes[plr] then
		hrp.Size         = OriginalSizes[plr]
		hrp.Transparency = 1
		hrp.CanCollide   = true
		hrp:SetAttribute("IsExpandedHitbox", nil)
		OriginalSizes[plr] = nil
	end
end
local function ToggleHBELoops(enable)
	if enable then
		if not HBEHeartbeatConn then
			HBEHeartbeatConn = RunService.Heartbeat:Connect(function()
				if not getgenv().HBE then return end
				local targetSize = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and IsAlive(p) then
						local hrp = p.Character:FindFirstChild("HumanoidRootPart")
						if hrp then
							if ShouldTargetPlayer(p, HBE_WhitelistMode) then
								OriginalSizes[p] = OriginalSizes[p] or hrp.Size
								if hrp.Size ~= targetSize then
									hrp.Size         = targetSize
									hrp.Transparency = 0.5
									hrp.Material     = Enum.Material.Neon
									hrp.Color        = Color3.fromRGB(175,25,255)
									hrp:SetAttribute("IsExpandedHitbox", true)
								end
							else
								RestoreHitbox(p)
							end
						end
					end
				end
			end)
		end
		if not HBESteppedConn then
			HBESteppedConn = RunService.Stepped:Connect(function()
				if not getgenv().HBE then return end
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character then
						local hrp = p.Character:FindFirstChild("HumanoidRootPart")
						if hrp and hrp:GetAttribute("IsExpandedHitbox") and hrp.CanCollide then
							hrp.CanCollide = false
						end
					end
				end
			end)
		end
	else
		if HBEHeartbeatConn then HBEHeartbeatConn:Disconnect(); HBEHeartbeatConn = nil end
		if HBESteppedConn then HBESteppedConn:Disconnect(); HBESteppedConn = nil end
		for _, p in ipairs(Players:GetPlayers()) do RestoreHitbox(p) end
		table.clear(OriginalSizes)
	end
end
