local function UpdateTargetInfoDisplay(target)
    if not TargetInfoFrame then return end
    if not target or not IsAlive(target) then
        TargetInfoFrame.Visible = false
        return
    end
    TargetInfoFrame.Visible = true
    TargetNameLabel.Text = "Target: " .. target.Name
    -- Ping del target (obtenido de manera segura desde Stats o atributo)
    pcall(function()
        local targetPing = 0
        if target:FindFirstChild("Ping") then
            targetPing = target.Ping.Value
        elseif target:GetAttribute("Ping") then
            targetPing = target:GetAttribute("Ping")
        else
            -- Si Roblox/Exploit no da el ping exacto del otro jugador, obtenemos el de Stats
            targetPing = math.floor(Stats.PerformanceStats.Ping:GetValue())
        end
        TargetPingLabel.Text = string.format("Ping: %d ms", targetPing)
    end)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tRoot  = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if myRoot and tRoot then
        local studs = math.floor((myRoot.Position - tRoot.Position).Magnitude)
        TargetDistLabel.Text = string.format("Dist: %d studs", studs)
    else
        TargetDistLabel.Text = "Dist: ? studs"
    end
    local hum = target.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        local hp = math.max(0, math.floor(hum.Health))
        local maxHp = math.floor(hum.MaxHealth)
        local pct = math.clamp(hp / maxHp, 0, 1)
        HealthBarFill.Size = UDim2.new(pct, 0, 1, 0)
        HealthLabel.Text = string.format("%d / %d HP (%d%%)", hp, maxHp, math.floor(pct * 100))
        HealthBarFill.BackgroundColor3 = Color3.fromRGB(math.floor(255 * (1 - pct)), math.floor(255 * pct), 100)
    end
    TargetTeamLabel.Text = "Equipo: " .. (target.Team and target.Team.Name or "Ninguno")
end
