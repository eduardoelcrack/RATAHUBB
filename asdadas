local function ToggleESPStuds(v)
	ESPStudsActive = v
	if v then
		for _, p in pairs(Players:GetPlayers()) do createESPStuds(p) end
		if not ESPStudsConn then
			ESPStudsConn = RunService.RenderStepped:Connect(function()
				if not ESPStudsActive then return end
				local myChar = LocalPlayer.Character
				local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
				if not myHRP then return end
				for player, data in pairs(ESPStudsObjects) do
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if hrp and hum and ShouldTargetPlayer(player, ESP_WhitelistMode) then
						data.Gui.Parent = hrp
						data.Gui.StudsOffset = Vector3.new(ESPOffsetX, ESPOffsetY, 0)
						local dist = (myHRP.Position - hrp.Position).Magnitude
						data.Dist.Text = math.floor(dist) .. " studs"
						local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
						data.Health.Text = "HP: " .. math.floor(hum.Health) .. " (" .. math.floor(hpPercent * 100) .. "%)"
						if hpPercent > 0.7 then data.Health.TextColor3 = Color3.fromRGB(0, 255, 100)
						elseif hpPercent > 0.3 then data.Health.TextColor3 = Color3.fromRGB(255, 200, 0)
						else data.Health.TextColor3 = Color3.fromRGB(255, 50, 50) end
					else
						data.Gui.Parent = nil
					end
				end
			end)
		end
	else
		if ESPStudsConn then ESPStudsConn:Disconnect(); ESPStudsConn = nil end
		for p, data in pairs(ESPStudsObjects) do if data.Gui then data.Gui:Destroy() end end
		table.clear(ESPStudsObjects)
	end
end
