ESPTab:CreateSection("Highlight ESP")
local ESPConns   = {}
local ESPStorage = nil
local function SetupHighlightESP(Value)
	ESPHighlightActive = Value
	if ESPStorage then ESPStorage:Destroy(); ESPStorage = nil end
	for _, c in pairs(ESPConns) do c:Disconnect() end
	ESPConns = {}
	if not Value then return end
	ESPStorage = Instance.new("Folder")
	ESPStorage.Name   = "Highlight_Storage"
	ESPStorage.Parent = CoreGui
	local function Highlight(plr)
		if plr == LocalPlayer then return end
		local function apply(char)
			if not char or not ESPStorage then return end
			local existing = ESPStorage:FindFirstChild(plr.Name)
			if existing then existing:Destroy() end
			if not ShouldTargetPlayer(plr, ESP_WhitelistMode) then return end
			local fillColor = ESPFillColor
			local outlineColor = ESPOutlineColor
			if TeamColorHighlightEnabled and plr.Team and plr.TeamColor then
				fillColor = plr.TeamColor.Color
				outlineColor = plr.TeamColor.Color
			end
			local h = Instance.new("Highlight")
			h.Name                = plr.Name
			h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
			h.FillColor           = fillColor
			h.OutlineColor        = outlineColor
			h.FillTransparency    = 0.5
			h.OutlineTransparency = 0
			h.Adornee             = char
			h.Parent              = ESPStorage
		end
		if plr.Character then task.spawn(apply, plr.Character) end
		local conn = plr.CharacterAdded:Connect(function(char)
			char:WaitForChild("HumanoidRootPart", 5)
			task.wait(0.1)
			apply(char)
		end)
		table.insert(ESPConns, conn)
		local connTeam = plr:GetPropertyChangedSignal("Team"):Connect(function()
			if plr.Character and ESPHighlightActive then apply(plr.Character) end
		end)
		table.insert(ESPConns, connTeam)
	end
	for _, p in ipairs(Players:GetPlayers()) do Highlight(p) end
	table.insert(ESPConns, Players.PlayerAdded:Connect(Highlight))
	table.insert(ESPConns, Players.PlayerRemoving:Connect(function(plr)
		if ESPStorage and ESPStorage:FindFirstChild(plr.Name) then 
			ESPStorage[plr.Name]:Destroy() 
		end
	end))
end
