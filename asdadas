local TracersEnabled = false
local TracerOrigin   = "Mouse"
local TracersObjects = {}
local TracersConn    = nil
local ESPTracerToggle = nil
local AimTracerToggle = nil
local function RemoveTracer(plr)
	if TracersObjects[plr] then
		pcall(function() TracersObjects[plr]:Remove() end)
		TracersObjects[plr] = nil
	end
end
local function CreateTracer(plr)
	if plr == LocalPlayer or TracersObjects[plr] then return end
	local line = Drawing.new("Line")
	line.Visible = false
	line.Color = Color3.fromRGB(255, 0, 0)
	line.Thickness = 1.5
	line.Transparency = 1
	TracersObjects[plr] = line
end
local function UpdateTracersState(enable)
	TracersEnabled = enable
	if enable then
		for _, p in ipairs(Players:GetPlayers()) do CreateTracer(p) end
		if not TracersConn then
			TracersConn = RunService.RenderStepped:Connect(function()
				if not TracersEnabled then return end
				local startPos = UserInputService:GetMouseLocation()
				if TracerOrigin == "Bottom" then
					local inset = GuiService:GetGuiInset()
					startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y - inset.Y)
				end
				for p, line in pairs(TracersObjects) do
					if p and p.Character and IsAlive(p) and p ~= LocalPlayer and ShouldTargetPlayer(p, ESP_WhitelistMode) and not (ESP_TeamCheck and IsSameTeam(p)) then
						local root = p.Character:FindFirstChild("HumanoidRootPart")
						if root then
							local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
							if onScreen then
								line.From = startPos
								line.To = Vector2.new(pos.X, pos.Y)
								if TeamColorTracerEnabled and p.Team and p.TeamColor then
									line.Color = p.TeamColor.Color
								else
									line.Color = Color3.fromRGB(255, 0, 0)
								end
								line.Visible = true
							else line.Visible = false end
						else line.Visible = false end
					else line.Visible = false end
				end
			end)
		end
	else
		if TracersConn then TracersConn:Disconnect(); TracersConn = nil end
		for p, line in pairs(TracersObjects) do RemoveTracer(p) end
		table.clear(TracersObjects)
	end
end
