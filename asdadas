local AimlockTab = Window:CreateTab("Aimlock", nil)
getgenv().Aimlock = { Enabled=false, ToggleOn=false }
local LockedTarget  = nil
local HeartbeatConn = nil
local AimHighlight  = nil
local function ClearAimESP()
	if AimHighlight then AimHighlight:Destroy(); AimHighlight = nil end
end
local function CreateAimESP(plr)
	ClearAimESP()
	if not plr or not plr.Character then return end
	AimHighlight = Instance.new("Highlight")
	AimHighlight.Name                = "AimlockESP"
	AimHighlight.Adornee             = plr.Character
	AimHighlight.FillColor           = Color3.fromRGB(255, 0, 0)
	AimHighlight.OutlineColor        = Color3.fromRGB(255, 255, 255)
	AimHighlight.FillTransparency    = 0.5
	AimHighlight.OutlineTransparency = 0
	AimHighlight.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	AimHighlight.Parent              = plr.Character
end
local function GetAimPart(char)
	if not char then return nil end
	if AimConfig.AimPart == "Head" then return char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
	elseif AimConfig.AimPart == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
	else
		for _, name in ipairs({"Head", "UpperTorso", "Torso", "HumanoidRootPart"}) do
			local p = char:FindFirstChild(name)
			if p then return p end
		end
		return char:FindFirstChildWhichIsA("BasePart")
	end
end
local function GetClosestTarget()
	local closestPlayer = nil
	local shortest      = math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and IsAlive(plr) and ShouldTargetPlayer(plr, AimConfig.WhitelistMode) then
			if AimConfig.TeamCheck and IsSameTeam(plr) then continue end
			local char = plr.Character
			if not char then continue end
			local head = char:FindFirstChild("Head")
			if not head then continue end
			local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
			if not onScreen then continue end
			local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
			if AimConfig.UseFOV and dist > AimConfig.FOVRadius then continue end
			if dist < shortest then
				shortest      = dist
				closestPlayer = plr
			end
		end
	end
	return closestPlayer
end
local function StopAimlock()
	getgenv().Aimlock.Enabled = false
	LockedTarget = nil
	ClearAimESP()
    UpdateTargetInfoDisplay(nil)
	if HeartbeatConn then HeartbeatConn:Disconnect(); HeartbeatConn = nil end
end
local function StartAimlock()
	StopAimlock()
	LockedTarget = GetClosestTarget()
	if not LockedTarget then
		Rayfield:Notify({Title="Aimlock", Content="Sin targets", Duration=1.5})
		return
	end
	getgenv().Aimlock.Enabled = true
	CreateAimESP(LockedTarget)
    if LockSoundEnabled then PlaySoundByName(SelectedLockSound) end
	HeartbeatConn = RunService.Heartbeat:Connect(function()
		if not getgenv().Aimlock.Enabled then return end
		if LockedTarget and not IsAlive(LockedTarget) then
			StopAimlock()
			Rayfield:Notify({Title="Aimlock", Content="Objetivo perdido", Duration=1.5})
			return
		end
		if LockedTarget and LockedTarget.Character then
			local part = GetAimPart(LockedTarget.Character)
			if part then
				local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
				local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
				if not onScreen or (AimConfig.UseMaxDistance and worldDist > AimConfig.MaxDistance) then
					StopAimlock()
					Rayfield:Notify({Title="Aimlock", Content="Objetivo fuera de rango", Duration=1.5})
					return
				end
			else
				StopAimlock()
				Rayfield:Notify({Title="Aimlock", Content="Objetivo perdido", Duration=1.5})
				return
			end
		end
		if LockedTarget and LockedTarget.Character then
			if AimHighlight and AimHighlight.Parent ~= LockedTarget.Character then
				CreateAimESP(LockedTarget)
			end
			local part = GetAimPart(LockedTarget.Character)
			if part then
                local targetPos = part.Position
                if AimConfig.Prediction then
                    local velocity = part.AssemblyLinearVelocity or Vector3.zero
                    targetPos = targetPos + (velocity * AimConfig.PredictionTime)
                end
				local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
				Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, AimConfig.Smoothness)
			end
            UpdateTargetInfoDisplay(LockedTarget)
		end
	end)
end
